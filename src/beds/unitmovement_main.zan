using System;

// The Zan side of the movement modification bed.
//
// The bed drives the same queries over the same unit types, base
// values and modifier states as the C++ bed
// (tools/cppbed/unitmovement_bed.cpp), so the two traces must match
// byte for byte.

public class UnitMovementBed {
    public static int Main(string[] args) {
        int variant = 0;
        if (args.Length >= 1) variant = Convert.ToInt32(args[0]);

        FlingyType flingy = new FlingyType(0, Fp.Integer(256), Fp.Integer(3), Fp.Integer(512), Fp.Integer(8), 0);

        // The unit types: a few that are not scouts, and the three that
        // are.
        int[] unitTypeIds = new int[] {
            (int)UnitTypes.Terran_Marine,
            (int)UnitTypes.Terran_Vulture,
            (int)UnitTypes.Terran_Siege_Tank_Tank_Mode,
            (int)UnitTypes.Terran_Battlecruiser,
            (int)UnitTypes.Zerg_Zergling,
            (int)UnitTypes.Zerg_Hydralisk,
            (int)UnitTypes.Protoss_Scout,
            (int)UnitTypes.Hero_Mojo,
            (int)UnitTypes.Hero_Artanis,
        };

        // The unit types, by id.
        List<UnitType> types = new List<UnitType>();
        for (int i = 0; i < 229; ++i) {
            UnitType t = new UnitType(i, flingy, 0, 0, 4, new Xy(4, 4), new Xy(4, 4));
            t.Hitpoints = Fp.Integer(50);
            types.Add(t);
        }

        // The base values, in the raw 8.8 form.
        int[] baseRaws = new int[] {
            0x0000, 0x0080, 0x0100, 0x0180, 0x0200, 0x0280, 0x0300,
            0x0380, 0x0400, 0x0480, 0x0500, 0x0580, 0x0600, 0x0680,
            0x0700, 0x0780, 0x0800, 0x0880, 0x0900, 0x0980, 0x0a00,
            0x0a80, 0x0b00, 0x0b80, 0x0c00, 0x0c80, 0x0d00, 0x0d80,
            0x0e00, 0x0e80, 0x0f00, 0x0f80, 0x1000, 0x1100, 0x1200,
        };

        Console.WriteLine("variant=" + variant);

        int caseIndex = 0;
        for (int ut = 0; ut < unitTypeIds.Length; ++ut) {
            for (int bi = 0; bi < baseRaws.Length; ++bi) {
                for (int sv = 0; sv < 16; ++sv) {
                    Unit u = new Unit();
                    u.UnitType = types[unitTypeIds[ut]];
                    u.Owner = 0;
                    u.StatusFlagBits = 0;
                    // The three modifiers, each in its own slice.
                    if ((sv + variant) % 16 == 1) u.StimTimer = 1;
                    if ((sv + variant) % 16 == 2) u.StatusFlagBits = u.StatusFlagBits | (int)StatusFlag.SpeedUpgrade;
                    if ((sv + variant) % 16 == 3) u.EnsnareTimer = 1;
                    if ((sv + variant) % 16 == 4) {
                        u.StimTimer = 1;
                        u.StatusFlagBits = u.StatusFlagBits | (int)StatusFlag.SpeedUpgrade;
                    }
                    if ((sv + variant) % 16 == 5) {
                        u.StimTimer = 1;
                        u.EnsnareTimer = 1;
                    }
                    if ((sv + variant) % 16 == 6) {
                        u.EnsnareTimer = 1;
                        u.StatusFlagBits = u.StatusFlagBits | (int)StatusFlag.SpeedUpgrade;
                    }
                    if ((sv + variant) % 16 == 7) {
                        u.StimTimer = 1;
                        u.EnsnareTimer = 1;
                        u.StatusFlagBits = u.StatusFlagBits | (int)StatusFlag.SpeedUpgrade;
                    }

                    Fp baseValue = Fp.FromRaw(baseRaws[bi]);
                    Fp speed = UnitMovement.GetModifiedUnitSpeed(u, baseValue);
                    Fp accel = UnitMovement.GetModifiedUnitAcceleration(u, baseValue);
                    Fp turn = UnitMovement.GetModifiedUnitTurnRate(u, baseValue);

                    Console.WriteLine("M " + caseIndex + " " + ut + " " + bi + " " + sv
                        + " " + speed.Raw
                        + " " + accel.Raw
                        + " " + turn.Raw
                        + " " + (UnitFlags.SpeedUpgrade(u) ? 1 : 0)
                        + " " + (UnitFlags.CooldownUpgrade(u) ? 1 : 0));
                    caseIndex = caseIndex + 1;
                }
            }
        }

        return 0;
    }
}
