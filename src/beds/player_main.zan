using System;

// The Zan side of the player state bed.
//
// The bed drives the same predicates over the same player records and
// per-player tables as the C++ bed (tools/cppbed/player_bed.cpp), so
// the two traces must match byte for byte.

public class PlayerBed {
    public static int Main(string[] args) {
        int variant = 0;
        if (args.Length >= 1) variant = Convert.ToInt32(args[0]);

        // The players. The controller and the victory state follow a
        // pattern so that every combination shows up.
        Player[] players = new Player[12];
        for (int p = 0; p < 12; ++p) {
            Player pl = new Player();
            pl.Controller = (p * 5 + variant * 7) % 12;
            pl.VictoryState = (p + variant) % 5;
            pl.Race = (Race)(p % 4);
            pl.Color = p;
            pl.Force = p % 2;
            pl.InitiallyActive = (p % 3) == 0;
            players[p] = pl;
        }

        // The per-player tables.
        int[][] unitCounts = new int[12][];
        int[][] completedUnitCounts = new int[12][];
        int[][] upgradeLevels = new int[12][];
        int[][] maxUpgradeLevels = new int[12][];
        bool[][] techResearched = new bool[12][];
        bool[][] techResearching = new bool[12][];
        bool[][] techAvailable = new bool[12][];
        bool[][] upgradeUpgrading = new bool[12][];
        for (int p = 0; p < 12; ++p) {
            unitCounts[p] = new int[228];
            completedUnitCounts[p] = new int[228];
            upgradeLevels[p] = new int[61];
            maxUpgradeLevels[p] = new int[61];
            techResearched[p] = new bool[44];
            techResearching[p] = new bool[44];
            techAvailable[p] = new bool[44];
            upgradeUpgrading[p] = new bool[61];
            for (int u = 0; u < 228; ++u) {
                unitCounts[p][u] = (p * 3 + u) % 4;
                completedUnitCounts[p][u] = (p + u * 5) % 3;
            }
            for (int k = 0; k < 61; ++k) {
                upgradeLevels[p][k] = (p + k) % 3;
                maxUpgradeLevels[p][k] = (p * 2 + k) % 5;
                upgradeUpgrading[p][k] = ((p + k) % 3) == 0;
            }
            for (int k = 0; k < 44; ++k) {
                techResearched[p][k] = ((p * 3 + k) % 5) < 2;
                techResearching[p][k] = ((p + k * 2) % 7) < 2;
                techAvailable[p][k] = ((p * 5 + k) % 3) == 0;
            }
        }

        // The tiles, for the visibility tests.
        TileMap tiles = new TileMap(16, 16);
        for (int i = 0; i < 16 * 16; ++i) {
            MapTile mt = new MapTile();
            mt.Tile.Visible = (i * 7 + 3) & 0xff;
            mt.Tile.Explored = (i * 13 + 5) & 0xff;
            tiles.Tiles.Add(mt);
        }

        Console.WriteLine("variant=" + variant);

        // The slot activity and the victory state.
        for (int p = 0; p < 12; ++p) {
            Console.WriteLine("P " + p +
                              " controller=" + players[p].Controller +
                              " victory=" + players[p].VictoryState +
                              " active=" + B(PlayerState.PlayerSlotActive(players, p)) +
                              " won=" + B(PlayerState.PlayerWon(players, p)) +
                              " defeated=" + B(PlayerState.PlayerDefeated(players, p)) +
                              " race=" + (int)players[p].Race +
                              " color=" + players[p].Color +
                              " force=" + players[p].Force +
                              " initially_active=" + B(players[p].InitiallyActive));
        }

        // The active players.
        Console.Write("ACTIVE");
        List<int> active = PlayerState.ActivePlayers(players);
        for (int i = 0; i < active.Count; ++i) {
            Console.Write(" " + active[i]);
        }
        Console.WriteLine("");

        // The per-player tables.
        for (int p = 0; p < 12; ++p) {
            for (int u = 0; u < 228; ++u) {
                Console.WriteLine("U " + p + " " + u +
                                  " has=" + B(PlayerState.PlayerHasUnit(unitCounts, p, u)) +
                                  " completed=" + B(PlayerState.PlayerHasCompletedUnit(completedUnitCounts, p, u)));
            }
            // The tech table has 44 entries and the upgrade table 61, so
            // the two are dumped separately.
            for (int k = 0; k < 44; ++k) {
                Console.WriteLine("K " + p + " " + k +
                                  " researched=" + B(PlayerState.PlayerHasResearched(techResearched, p, k)) +
                                  " researching=" + B(PlayerState.PlayerIsResearching(techResearching, p, k)) +
                                  " available=" + B(PlayerState.PlayerTechAvailable(techAvailable, p, k)) +
                                  " has_upgrade=" + B(PlayerState.PlayerHasUpgrade(upgradeLevels, p, k)) +
                                  " upgrading=" + B(PlayerState.PlayerIsUpgrading(upgradeUpgrading, p, k)) +
                                  " max_level=" + PlayerState.PlayerMaxUpgradeLevel(maxUpgradeLevels, p, k));
            }
            for (int k = 44; k < 61; ++k) {
                Console.WriteLine("G " + p + " " + k +
                                  " has_upgrade=" + B(PlayerState.PlayerHasUpgrade(upgradeLevels, p, k)) +
                                  " upgrading=" + B(PlayerState.PlayerIsUpgrading(upgradeUpgrading, p, k)) +
                                  " max_level=" + PlayerState.PlayerMaxUpgradeLevel(maxUpgradeLevels, p, k));
            }
        }

        // The visibility tests.
        for (int p = 0; p < 12; ++p) {
            for (int ty = 0; ty < 16; ++ty) {
                for (int tx = 0; tx < 16; ++tx) {
                    Xy pos = new Xy(tx * 32 + 16, ty * 32 + 16);
                    Console.WriteLine("V " + p + " " + tx + " " + ty +
                                      " visible=" + B(PlayerState.PlayerPositionIsVisible(tiles, p, pos)) +
                                      " explored=" + B(PlayerState.PlayerPositionIsExplored(tiles, p, pos)));
                }
            }
        }

        return 0;
    }

    private static string B(bool v) {
        if (v) return "1";
        return "0";
    }
}
