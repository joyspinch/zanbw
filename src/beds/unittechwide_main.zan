using System;

// The wide bed for the unit tech / upgrade layer.
//
// The bed drives the same queries over the same unit types, techs,
// upgrades and player states as the C++ bed
// (tools/cppbed/unittechwide_bed.cpp), so the two traces must match byte
// for byte.

public class UnitTechWideBed {
    public static int Main(string[] args) {
        int variant = 0;
        if (args.Length >= 1) variant = Convert.ToInt32(args[0]);

        FlingyType flingy = new FlingyType(0, Fp.Integer(256), Fp.Integer(3), Fp.Integer(512), Fp.Integer(8), 0);

        // The unit types.
        List<UnitType> types = new List<UnitType>();
        for (int i = 0; i < 229; ++i) {
            UnitType t = new UnitType(i, flingy, 0, 0, 4, new Xy(4, 4), new Xy(4, 4));
            t.Hitpoints = Fp.Integer(50);
            t.GroupFlags = (i % 3 == 0) ? 1 : ((i % 3 == 1) ? 2 : 4);
            if (i >= 10 && i <= 28) t.Flags = t.Flags | (int)UnitTypeFlag.Hero;
            types.Add(t);
        }

        Console.WriteLine("variant=" + variant);

        int[] unitTypeIds = UnitTypeIds.BedList();

        int caseIndex = 0;
        for (int ut = 0; ut < unitTypeIds.Length; ++ut) {
            for (int tech = 0; tech < 36; ++tech) {
                for (int sv = 0; sv < 16; ++sv) {
                    int owner = caseIndex % 12;
                    int statusFlags = 0;
                    if ((sv + variant) % 16 != 3) statusFlags = statusFlags | (int)StatusFlag.Completed;
                    if ((sv + variant) % 16 == 2) statusFlags = statusFlags | (int)StatusFlag.Hallucination;
                    if ((sv + variant) % 16 != 6) statusFlags = statusFlags | (int)StatusFlag.GroundedBuilding;

                    Unit u = MakeUnit(types[unitTypeIds[ut]], owner, statusFlags);
                    if ((sv + variant) % 16 == 1) u.ResearchingTypeId = 0;
                    if ((sv + variant) % 16 == 4) u.UpgradingTypeId = 0;
                    if ((sv + variant) % 16 == 5) u.LockdownTimer = 1;
                    if ((sv + variant) % 16 == 7) u.StasisTimer = 1;
                    if ((sv + variant) % 16 == 9) u.MaelstromTimer = 1;
                    u.SpiderMineCount = (sv + variant) % 3;

                    PlayerTechState p = MakeState(owner, sv, tech, variant);
                    bool canResearch = UnitTech.UnitCanResearch(u, tech, true, true, p);
                    bool canUse = UnitTech.UnitCanUseTech(u, tech, true, true, p);

                    Console.WriteLine("R " + caseIndex + " " + ut + " " + tech + " "
                        + (canResearch ? 1 : 0) + " " + (canUse ? 1 : 0));
                    caseIndex = caseIndex + 1;
                }
            }
        }

        for (int ut = 0; ut < unitTypeIds.Length; ++ut) {
            for (int up = 0; up < 56; ++up) {
                for (int sv = 0; sv < 16; ++sv) {
                    int owner = caseIndex % 12;
                    int statusFlags = 0;
                    if ((sv + variant) % 16 != 3) statusFlags = statusFlags | (int)StatusFlag.Completed;
                    if ((sv + variant) % 16 == 2) statusFlags = statusFlags | (int)StatusFlag.Hallucination;
                    if ((sv + variant) % 16 != 6) statusFlags = statusFlags | (int)StatusFlag.GroundedBuilding;

                    Unit u = MakeUnit(types[unitTypeIds[ut]], owner, statusFlags);
                    if ((sv + variant) % 16 == 1) u.ResearchingTypeId = 0;
                    if ((sv + variant) % 16 == 4) u.UpgradingTypeId = 0;
                    if ((sv + variant) % 16 == 5) u.LockdownTimer = 1;
                    if ((sv + variant) % 16 == 7) u.StasisTimer = 1;
                    if ((sv + variant) % 16 == 9) u.MaelstromTimer = 1;
                    u.SpiderMineCount = (sv + variant) % 3;

                    PlayerTechState p = MakeState(owner, sv, up, variant);
                    bool canUpgrade = UnitTech.UnitCanUpgrade(u, up, true, true, p);

                    Console.WriteLine("U " + caseIndex + " " + ut + " " + up + " "
                        + (canUpgrade ? 1 : 0));
                    caseIndex = caseIndex + 1;
                }
            }
        }

        return 0;
    }


    private static Unit MakeUnit(UnitType t, int owner, int statusFlags) {
        Unit u = new Unit();
        u.UnitType = t;
        u.Owner = owner;
        u.StatusFlagBits = statusFlags;
        u.OrderId = (int)Orders.Stop;
        u.SecondaryOrderId = (int)Orders.Stop;
        u.SpritePosition = new Xy(0, 0);
        u.Hp = Fp.Integer(50);
        u.ResearchingTypeId = -1;
        u.UpgradingTypeId = -1;
        u.SpiderMineCount = 0;
        return u;
    }

    // The state the layer reads: one table per id, filled the same
    // way the C++ bed fills it.
    private static PlayerTechState MakeState(int owner, int state, int underTest, int variant) {
        PlayerTechState p = new PlayerTechState();
        p.TechAvailable = (state + variant) % 16 != 1;
        p.HasResearched = (state + variant) % 16 == 4;
        p.IsResearching = (state + variant) % 16 == 2;
        p.IsUpgrading = (state + variant) % 16 == 3;
        p.UpgradeLevel = ((underTest + state + variant) % 3 == 0) ? 1 : 0;
        p.MaxUpgradeLevel = 3;
        for (int t2 = 0; t2 < 44; ++t2) {
            bool isUnderTest = (t2 == underTest);
            p.HasResearchedByTech.Add(isUnderTest
                ? ((state + variant) % 16 == 4)
                : ((t2 + state + variant) % 17 == 0));
            p.UpgradeLevelById.Add(((t2 + state + variant) % 3 == 0) ? 1 : 0);
        }
        for (int u = 0; u < 229; ++u) {
            p.HasCompletedUnit.Add(((u + state + variant) % 3 == 0) ? true : false);
            p.HasUnit.Add(((u + state + variant) % 5 == 0) ? true : false);
        }
        return p;
    }
}
