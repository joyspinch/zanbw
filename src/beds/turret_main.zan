using System;

// The Zan side of the turret bed.
//
// The bed drives the same queries over the same turret units, headings
// and turn amounts as the C++ bed (tools/cppbed/turret_bed.cpp), so the
// two traces must match byte for byte.

public class TurretBed {
    public static int Main(string[] args) {
        int variant = 0;
        if (args.Length >= 1) variant = Convert.ToInt32(args[0]);

        FlingyType flingy = new FlingyType(0, Fp.Integer(256), Fp.Integer(3), Fp.Integer(512), Fp.Integer(8), 0);

        // The unit types, by id.
        List<UnitType> types = new List<UnitType>();
        for (int i = 0; i < 229; ++i) {
            UnitType t = new UnitType(i, flingy, 0, 0, 4, new Xy(4, 4), new Xy(4, 4));
            t.Hitpoints = Fp.Integer(50);
            types.Add(t);
        }

        Console.WriteLine("variant=" + variant);

        // The turret's unit types.
        int[] turretTypes = new int[] {
            (int)UnitTypes.Terran_Goliath_Turret,
            (int)UnitTypes.Hero_Alan_Schezar_Turret,
            (int)UnitTypes.Terran_Siege_Tank_Tank_Mode,
            (int)UnitTypes.Protoss_Photon_Cannon,
            (int)UnitTypes.Zerg_Extractor,
            (int)UnitTypes.Terran_Bunker,
        };
        int turretTypeCount = turretTypes.Length;

        int caseIndex = 0;
        for (int tt = 0; tt < turretTypeCount; ++tt) {
            for (int h = 0; h < 16; ++h) {
                for (int sh = 0; sh < 16; ++sh) {
                    for (int sv = 0; sv < 4; ++sv) {
                        UnitType t = types[turretTypes[tt]];

                        Unit u = new Unit();
                        u.UnitType = t;
                        u.Owner = 0;
                        u.StatusFlagBits = 0;
                        u.Sprite = new Sprite();
                        u.Hp = Fp.Integer(50);
                        // The state shifts with the variant so the
                        // variants really differ.
                        u.Heading = new Dir((h * 16 + variant * 4) & 0xff);
                        u.NextVelocityDirection = new Dir((h * 16 + sv * 8 + variant * 4) & 0xff);

                        // The turret's own heading.
                        Unit subunit = new Unit();
                        subunit.UnitType = t;
                        subunit.Owner = 0;
                        subunit.StatusFlagBits = 0;
                        subunit.Sprite = new Sprite();
                        subunit.Hp = Fp.Integer(50);
                        subunit.Heading = new Dir((sh * 16 + variant * 4) & 0xff);

                        // A target on the turret, for some of the cases.
                        if (sv % 2 == 0) {
                            Unit target = new Unit();
                            target.UnitType = types[(int)UnitTypes.Terran_Marine];
                            target.Owner = 1;
                            target.StatusFlagBits = 0;
                            target.Sprite = new Sprite();
                            target.Hp = Fp.Integer(50);
                            u.OrderTarget = new OrderTarget();
                            u.OrderTarget.UnitId = 1;
                        } else {
                            u.OrderTarget = new OrderTarget();
                            u.OrderTarget.UnitId = 0;
                        }

                        // The turn amount.
                        Dir turn = new Dir((sv * 13 - 16) & 0xff);

                        Turret.TurnTurret(u, subunit, turn);

                        Console.WriteLine("T " + caseIndex + " " + tt + " " + h + " " + sh + " " + sv
                            + " " + t.Id
                            + " " + u.Heading.Raw
                            + " " + u.NextVelocityDirection.Raw
                            + " " + subunit.Heading.Raw
                            + " " + u.StatusFlagBits
                            + " " + turn.Raw
                            + " " + u.OrderTarget.UnitId
                            + " " + subunit.Heading.Raw);
                        caseIndex = caseIndex + 1;
                    }
                }
            }
        }

        return 0;
    }
}
