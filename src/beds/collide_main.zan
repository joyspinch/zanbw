using System;

// Entry point of the unit-to-unit collision differential test.
//
//   zanbw_collide.exe <terrain variant> <scenario>
//
// The output format matches tools/cppbed/collide_bed.cpp exactly.
//
// The bed creates two ground units, gives them a move order and lets the
// real movement state machine run. A unit that stands still has its move
// target on itself, and the pathfinder treats such a unit as an
// obstacle, so the path goes around it. A unit that moves does not, so
// the path goes straight through it and the collision happens at run
// time. Both units therefore get a move order.

public class CollideMain {
    static int Main(string[] args) {
        int variant = 0;
        if (args.Length >= 1) variant = Convert.ToInt32(args[0]);
        int scen = 0;
        if (args.Length >= 2) scen = Convert.ToInt32(args[1]);
        Terrain.Variant = variant;

        // The scenarios must match the C++ bed one for one.
        List<PairScenario> scenarios = ScenarioTable.Collision();
        if (scen < 0 || scen >= scenarios.Count) return 1;
        PairScenario scenario = scenarios[scen];
        string name = scenario.Name;

        Regions r = new Regions(Terrain.TileWidth, Terrain.TileHeight);
        for (int y = 0; y < Terrain.TileHeight; y++) {
            for (int x = 0; x < Terrain.TileWidth; x++) {
                r.MegaTileIndex[y * Terrain.TileWidth + x] = Terrain.MegaTileIndex(x, y);
                r.TileFlags[y * Terrain.TileWidth + x] = Terrain.TileFlags(x, y);
            }
        }
        for (int i = 0; i < 16; i++) {
            r.Vf4Flags[i] = 1;
            r.Vf4Flags[16 + i] = 0;
            r.Vf4Flags[32 + i] = (i / 4 >= 2) ? 1 : 0;
        }

        RegionsMain rm = new RegionsMain(r);
        rm.RegionsCreate();

        Sim sim = new Sim(new Rng(), Terrain.TileWidth * 32, Terrain.TileHeight * 32);
        sim.MaxUnitWidth = 64;
        sim.MaxUnitHeight = 64;

        FlingyType ft = new FlingyType(0, Fp.Integer(256), Fp.Integer(3),
                                       Fp.Integer(512), Fp.Integer(8), 0);
        UnitType ut = new UnitType(0, ft, 0,
            (int)UnitTypeFlag.CanMove | (int)UnitTypeFlag.CanTurn, 7,
            new Xy(8, 8), new Xy(8, 8));

        Unit a = MakeUnit(sim, r, ut, ft, scenario.First.StartX, scenario.First.StartY);
        Unit b = MakeUnit(sim, r, ut, ft, scenario.Second.StartX, scenario.Second.StartY);

        PathProgress ppA = new PathProgress(r, sim, a);
        PathProgress ppB = new PathProgress(r, sim, b);
        StateMachine smA = new StateMachine(sim, r, ppA, a);
        StateMachine smB = new StateMachine(sim, r, ppB, b);

        Console.WriteLine("scenario=" + name + " variant=" + variant);

        int toAX = scenario.First.TargetX;
        int toAY = scenario.First.TargetY;
        ppA.SetUnitMoveTarget(toAX, toAY);
        Console.WriteLine("S 0 frame=0 to=" + toAX + "," + toAY);
        DumpUnit("  U", a, ppA);

        int frame = 0;
        int totalFrames = 40;

        while (frame < totalFrames) {
            if (frame == scenario.Second.Delay) {
                int toBX = scenario.Second.TargetX;
                int toBY = scenario.Second.TargetY;
                ppB.SetUnitMoveTarget(toBX, toBY);
                Console.WriteLine("S 1 frame=" + frame + " to=" + toBX + "," + toBY);
                DumpUnit("  U", b, ppB);
            }

            smA.ExecuteMovement();
            Console.WriteLine("  chainA f" + frame + ": " + ChainText(smA.Chain));
            smB.ExecuteMovement();
            Console.WriteLine("  chainB f" + frame + ": " + ChainText(smB.Chain));
            frame = frame + 1;
            ppA.CurrentFrame = frame;
            ppB.CurrentFrame = frame;

            if ((frame % 4) == 0) {
                DumpUnit("F" + frame, a, ppA);
                DumpUnit("F" + frame, b, ppB);
            }
        }

        DumpUnit("FINAL", a, ppA);
        DumpUnit("FINAL", b, ppB);
        return 0;
    }

    // openbw: create_unit() plus the two things show_unit() does that the
    // bed needs: the unit becomes visible and enters the unit finder.
    static Unit MakeUnit(Sim sim, Regions r, UnitType ut, FlingyType ft, int x, int y) {
        Unit u = new Unit();
        u.UnitType = ut;
        u.FlingyType = ft;
        u.Owner = 0;
        u.Position = new Xy(x, y);
        u.ExactPosition = Kin.ToXyFp8(u.Position);
        u.Sprite = new Sprite();
        u.Sprite.Position = u.Position;
        u.MoveTargetPos = new Xy(x, y);
        u.NextMovementWaypoint = new Xy(x, y);
        u.NextTargetWaypoint = new Xy(x, y);
        u.NextSpeed = ft.TopSpeed;
        u.CurrentSpeed = Fp.Zero();
        u.FlingyTopSpeed = ft.TopSpeed;
        u.FlingyAcceleration = ft.Acceleration;
        u.FlingyTurnRate = ft.TurnRate;
        u.FlingyMovementType = 0;
        u.NextVelocityDirection = Dir.FromRaw(64);
        u.CurrentVelocityDirection = Dir.FromRaw(64);
        u.DesiredVelocityDirection = Dir.FromRaw(64);
        u.SetStatus(StatusFlag.CanTurn);
        u.SetStatus(StatusFlag.CanMove);
        u.SetStatus(StatusFlag.GroundUnit);
        u.MovementFlags = 1;
        u.PathingFlags = 1;

        u.UnitIdIndex = sim.Units.Count;
        sim.Units.Add(u);

        // openbw: show_unit() unhides the unit and inserts it into the
        // unit finder.
        u.Sprite.Flags = u.Sprite.Flags & ~((int)SpriteFlag.Hidden);
        int fromX = u.Position.X - ut.DimensionsFrom.X;
        int toX = u.Position.X + ut.DimensionsTo.X;
        int fromY = u.Position.Y - ut.DimensionsFrom.Y;
        int toY = u.Position.Y + ut.DimensionsTo.Y;
        sim.Finder.Insert(u, fromX, toX, fromY, toY);
        return u;
    }

    static string ChainText(List<int> chain) {
        string r = "";
        for (int i = 0; i < chain.Count; i++) {
            if (i > 0) r = r + " ";
            r = r + chain[i].ToString();
        }
        return r;
    }

    static void DumpUnit(string tag, Unit u, PathProgress pp) {
        string line = tag + " state=" + StateName(u.MovementState)
            + " pos=" + u.Position.X + "," + u.Position.Y
            + " exact=" + u.ExactPosition.X.RawValue() + "," + u.ExactPosition.Y.RawValue()
            + " speed=" + u.CurrentSpeed.RawValue()
            + " next_speed=" + u.NextSpeed.RawValue()
            + " vel=" + u.Velocity.X.RawValue() + "," + u.Velocity.Y.RawValue()
            + " vdir=" + u.NextVelocityDirection.RawValue()
            + " cdir=" + u.CurrentVelocityDirection.RawValue()
            + " ddir=" + u.DesiredVelocityDirection.RawValue()
            + " heading=" + u.Heading.RawValue()
            + " mt=" + u.MoveTargetPos.X + "," + u.MoveTargetPos.Y
            + " waypoint=" + u.NextMovementWaypoint.X + "," + u.NextMovementWaypoint.Y
            + " target_waypoint=" + u.NextTargetWaypoint.X + "," + u.NextTargetWaypoint.Y
            + " flags=0x" + Hex(u.MovementFlags)
            + " pcc=" + u.PathingCollisionCounter
            + " status=0x" + Hex(u.StatusFlagBits)
            + " has_path=" + (pp.Current == null ? 0 : 1);
        Path p = pp.Current;
        if (p != null) {
            line = line + " path(delay=" + p.Delay
                + " sf=" + p.StateFlags
                + " cli=" + p.CurrentLongPathIndex
                + " csi=" + p.CurrentShortPathIndex
                + " src=" + p.SourceX + "," + p.SourceY
                + " dst=" + p.DestinationX + "," + p.DestinationY
                + " next=" + p.NextX + "," + p.NextY
                + " long=" + p.LongPath.Count
                + " short=" + p.ShortPath.Count + ")";
            line = line + " sp=[";
            for (int i = 0; i < p.ShortPath.Count; i++) {
                if (i > 0) line = line + ",";
                line = line + p.ShortPath[i][0] + "," + p.ShortPath[i][1];
            }
            line = line + "]";
        }
        Console.WriteLine(line);
    }

    static string StateName(MovementStates s) {
        switch (s) {
            case MovementStates.UM_Init: return "Init";
            case MovementStates.UM_InitSeq: return "InitSeq";
            case MovementStates.UM_Lump: return "Lump";
            case MovementStates.UM_Turret: return "Turret";
            case MovementStates.UM_Bunker: return "Bunker";
            case MovementStates.UM_BldgTurret: return "BldgTurret";
            case MovementStates.UM_Hidden: return "Hidden";
            case MovementStates.UM_Flyer: return "Flyer";
            case MovementStates.UM_FakeFlyer: return "FakeFlyer";
            case MovementStates.UM_AtRest: return "AtRest";
            case MovementStates.UM_Dormant: return "Dormant";
            case MovementStates.UM_AtMoveTarget: return "AtMoveTarget";
            case MovementStates.UM_CheckIllegal: return "CheckIllegal";
            case MovementStates.UM_MoveToLegal: return "MoveToLegal";
            case MovementStates.UM_LumpWannabe: return "LumpWannabe";
            case MovementStates.UM_FailedPath: return "FailedPath";
            case MovementStates.UM_RetryPath: return "RetryPath";
            case MovementStates.UM_StartPath: return "StartPath";
            case MovementStates.UM_UIOrderDelay: return "UIOrderDelay";
            case MovementStates.UM_TurnAndStart: return "TurnAndStart";
            case MovementStates.UM_FaceTarget: return "FaceTarget";
            case MovementStates.UM_NewMoveTarget: return "NewMoveTarget";
            case MovementStates.UM_AnotherPath: return "AnotherPath";
            case MovementStates.UM_Repath: return "Repath";
            case MovementStates.UM_RepathMovers: return "RepathMovers";
            case MovementStates.UM_FollowPath: return "FollowPath";
            case MovementStates.UM_ScoutPath: return "ScoutPath";
            case MovementStates.UM_ScoutFree: return "ScoutFree";
            case MovementStates.UM_FixCollision: return "FixCollision";
            case MovementStates.UM_WaitFree: return "WaitFree";
            case MovementStates.UM_GetFree: return "GetFree";
            case MovementStates.UM_SlidePrep: return "SlidePrep";
            case MovementStates.UM_SlideFree: return "SlideFree";
            case MovementStates.UM_ForceMoveFree: return "ForceMoveFree";
            case MovementStates.UM_FixTerrain: return "FixTerrain";
            case MovementStates.UM_TerrainSlide: return "TerrainSlide";
            default: return "?";
        }
    }

    static string Hex(int v) {
        if (v == 0) return "0";
        string digits = "0123456789abcdef";
        string r = "";
        int x = v;
        while (x != 0) {
            r = digits[x & 0xf] + r;
            x = x >> 4;
        }
        return r;
    }
}
