using System;

// The Zan side of the weapon targeting bed.
//
// The bed drives the same queries over the same weapons, targets and
// shooters as the C++ bed (tools/cppbed/weapontargeting_bed.cpp), so
// the two traces must match byte for byte.

public class WeaponTargetingBed {
    public static int Main(string[] args) {
        int variant = 0;
        if (args.Length >= 1) variant = Convert.ToInt32(args[0]);

        FlingyType flingy = new FlingyType(0, Fp.Integer(256), Fp.Integer(3), Fp.Integer(512), Fp.Integer(8), 0);

        // The unit types, by id.
        List<UnitType> types = new List<UnitType>();
        for (int i = 0; i < 229; ++i) {
            UnitType t = new UnitType(i, flingy, 0, 0, 4, new Xy(4, 4), new Xy(4, 4));
            t.Hitpoints = Fp.Integer(50);
            types.Add(t);
        }
        // The weapons.
        List<WeaponType> weapons = new List<WeaponType>();
        for (int i = 0; i < 117; ++i) {
            weapons.Add(new WeaponType());
        }

        Console.WriteLine("variant=" + variant);

        int[] targetTypeIds = new int[] {
            (int)UnitTypes.Terran_Marine,
            (int)UnitTypes.Terran_SCV,
            (int)UnitTypes.Terran_Wraith,
            (int)UnitTypes.Terran_Bunker,
            (int)UnitTypes.Terran_Siege_Tank_Tank_Mode,
            (int)UnitTypes.Terran_Vulture,
            (int)UnitTypes.Zerg_Zergling,
            (int)UnitTypes.Zerg_Hydralisk,
            (int)UnitTypes.Zerg_Ultralisk,
            (int)UnitTypes.Zerg_Larva,
            (int)UnitTypes.Zerg_Egg,
            (int)UnitTypes.Zerg_Extractor,
            (int)UnitTypes.Zerg_Hatchery,
            (int)UnitTypes.Protoss_Zealot,
            (int)UnitTypes.Protoss_Probe,
            (int)UnitTypes.Protoss_Shuttle,
            (int)UnitTypes.Protoss_Scarab,
            (int)UnitTypes.Protoss_Photon_Cannon,
            (int)UnitTypes.Protoss_Pylon,
            (int)UnitTypes.Protoss_Arbiter,
            (int)UnitTypes.Protoss_Interceptor,
        };
        int targetTypeCount = targetTypeIds.Length;

        int[] flagSets = new int[] {
            0x00, 0x01, 0x02, 0x03, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
            0x100, 0x05, 0x0a, 0x14, 0x24, 0x84, 0x1c, 0x140, 0x143, 0x1ff,
        };
        int flagSetCount = flagSets.Length;

        int caseIndex = 0;
        for (int fs = 0; fs < flagSetCount; ++fs) {
            for (int tt = 0; tt < targetTypeCount; ++tt) {
                for (int sv = 0; sv < 4; ++sv) {
                    WeaponType w = weapons[0];
                    w.TargetFlags = flagSets[fs];

                    UnitType t = types[targetTypeIds[tt]];
                    // The kind of the target: flying, mechanical,
                    // organic, robotic or a building.
                    t.Flags = 0;
                    // openbw's GroupFlags is a bit set: Zerg 1,
                    // Terran 2, Protoss 4.
                    t.GroupFlags = (sv == 0) ? 2 : ((sv == 1) ? 1 : 4);
                    // The kind of the target shifts with the variant so
                    // the variants really differ.
                    int kind = (sv + variant) % 4;
                    if (kind == 1) t.Flags = t.Flags | (int)UnitTypeFlag.Organic;
                    if (kind == 2) t.Flags = t.Flags | (int)UnitTypeFlag.Mechanical;
                    if (kind == 3) t.Flags = t.Flags | (int)UnitTypeFlag.Robotic;
                    if ((tt + variant) % 5 == 0) t.Flags = t.Flags | (int)UnitTypeFlag.Building;

                    // The target.
                    Unit target = new Unit();
                    target.UnitType = t;
                    target.Owner = 0;
                    target.StatusFlagBits = 0;
                    target.Sprite = new Sprite();
                    target.Hp = Fp.Integer(50);
                    if (kind == 2) {
                        target.StatusFlagBits = target.StatusFlagBits | (int)StatusFlag.Flying;
                    }
                    if (kind == 3) {
                        target.StatusFlagBits = target.StatusFlagBits | (int)StatusFlag.Invincible;
                    }

                    // The shooter.
                    Unit shooter = new Unit();
                    shooter.UnitType = types[(int)UnitTypes.Terran_Marine];
                    shooter.Owner = (sv % 2);
                    shooter.StatusFlagBits = 0;
                    shooter.Sprite = new Sprite();
                    shooter.Hp = Fp.Integer(50);
                    target.Owner = (sv % 2 == 0) ? 0 : 1;

                    bool canTarget = WeaponTargeting.WeaponCanTargetUnit(w, target);
                    bool canTargetBy = WeaponTargeting.WeaponCanTargetUnitBy(w, target, shooter);

                    Console.WriteLine("T " + caseIndex + " " + fs + " " + tt + " " + sv
                        + " " + w.TargetFlags
                        + " " + t.Flags
                        + " " + t.GroupFlags
                        + " " + target.StatusFlagBits
                        + " " + target.Owner
                        + " " + shooter.Owner
                        + " " + (canTarget ? 1 : 0) + " " + (canTargetBy ? 1 : 0)
                        + " " + targetTypeIds[tt]);
                    caseIndex = caseIndex + 1;
                }
            }
        }

        // The empty target case.
        caseIndex = 0;
        for (int fs = 0; fs < flagSetCount; ++fs) {
            WeaponType w = weapons[0];
            w.TargetFlags = flagSets[fs];
            bool canTarget = WeaponTargeting.WeaponCanTargetUnit(w, null);
            Console.WriteLine("E " + caseIndex + " " + fs + " " + w.TargetFlags
                + " " + (canTarget ? 1 : 0));
            caseIndex = caseIndex + 1;
        }

        return 0;
    }
}
