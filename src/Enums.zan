using System;

// Enumerations mirroring openbw's bwenums.h / game_types.h flag sets.
//
// These are native Zan enums so that they can be used as compile-time
// constant case labels (Zan requires constant case labels in an integer
// switch) and as bitmask values.

public enum MovementStates {
    UM_Init = 0,
    UM_InitSeq = 1,
    UM_Lump = 2,
    UM_Turret = 3,
    UM_Bunker = 4,
    UM_BldgTurret = 5,
    UM_Hidden = 6,
    UM_Flyer = 7,
    UM_FakeFlyer = 8,
    UM_AtRest = 9,
    UM_Dormant = 10,
    UM_AtMoveTarget = 11,
    UM_CheckIllegal = 12,
    UM_MoveToLegal = 13,
    UM_LumpWannabe = 14,
    UM_FailedPath = 15,
    UM_RetryPath = 16,
    UM_StartPath = 17,
    UM_UIOrderDelay = 18,
    UM_TurnAndStart = 19,
    UM_FaceTarget = 20,
    UM_NewMoveTarget = 21,
    UM_AnotherPath = 22,
    UM_Repath = 23,
    UM_RepathMovers = 24,
    UM_FollowPath = 25,
    UM_ScoutPath = 26,
    UM_ScoutFree = 27,
    UM_FixCollision = 28,
    UM_WaitFree = 29,
    UM_GetFree = 30,
    UM_SlidePrep = 31,
    UM_SlideFree = 32,
    UM_ForceMoveFree = 33,
    UM_FixTerrain = 34,
    UM_TerrainSlide = 35
}

public enum StatusFlag {
    Completed = 1,
    GroundedBuilding = 2,
    Flying = 4,
    Flag8 = 8,
    Burrowed = 0x10,
    InBunker = 0x20,
    Loaded = 0x40,
    RequiresDetector = 0x100,
    Cloaked = 0x200,
    Disabled = 0x400,
    PassivelyCloaked = 0x800,
    OrderNotInterruptible = 0x1000,
    IscriptNobrk = 0x2000,
    Flag4000 = 0x4000,
    CannotAttack = 0x8000,
    CanTurn = 0x10000,
    CanMove = 0x20000,
    Collision = 0x40000,
    Immovable = 0x80000,
    GroundUnit = 0x100000,
    NoCollide = 0x200000,
    Flag400000 = 0x400000,
    Gathering = 0x800000,
    TurretWalking = 0x1000000,
    Invincible = 0x4000000,
    ReadyToAttack = 0x8000000,
    SpeedUpgrade = 0x10000000,
    CooldownUpgrade = 0x20000000,
    Hallucination = 0x40000000
}

// status_flag_lifetime_expired (0x80000000) does not fit in a 32-bit signed
// enum and is not referenced by the movement layer; it is kept here as a
// plain constant for completeness.
public class StatusFlagExtra {
    public const int LifetimeExpired = unchecked((int)0x80000000);
}

public enum UnitTypeFlag {
    Building = 1,
    Addon = 2,
    Flyer = 4,
    Worker = 8,
    Turret = 0x10,
    FlyingBuilding = 0x20,
    Hero = 0x40,
    CanBurrow = 0x100000,
    CanMove = 0x8000000,
    CanTurn = 0x10000000,
    Invincible = 0x20000000,
    Mechanical = 0x40000000
}

public enum SpriteFlag {
    Selected = 0x8,
    Turret = 0x10,
    Hidden = 0x20,
    Burrowed = 0x40,
    IscriptNobrk = 0x80
}
