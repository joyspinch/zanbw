using System;

// Integer point, port of openbw's xy_t<int>.
public struct Xy {
    public int X;
    public int Y;

    public Xy(int x, int y) { X = x; Y = y; }

    public static bool operator ==(Xy a, Xy b) { return a.X == b.X && a.Y == b.Y; }
    public static bool operator !=(Xy a, Xy b) { return !(a.X == b.X && a.Y == b.Y); }

    public static Xy operator +(Xy a, Xy b) { return new Xy(a.X + b.X, a.Y + b.Y); }
    public static Xy operator -(Xy a, Xy b) { return new Xy(a.X - b.X, a.Y - b.Y); }

    public Xy Neg() { return new Xy(-X, -Y); }

    public int Length() { return XyMath.XyLength(this); }
}

// openbw bwgame.h:
//   int xy_length(xy vec) const {
//       unsigned int x = std::abs(vec.x);
//       unsigned int y = std::abs(vec.y);
//       if (x < y) std::swap(x, y);
//       if (x / 4 < y) x = x - x / 16 + y * 3 / 8 - x / 64 + y * 3 / 256;
//       return x;
//   }
public class XyMath {
    public static int XyLength(Xy vec) {
        uint x = (uint)(vec.X < 0 ? -vec.X : vec.X);
        uint y = (uint)(vec.Y < 0 ? -vec.Y : vec.Y);
        if (x < y) { uint t = x; x = y; y = t; }
        if (x / 4u < y) {
            x = x - x / 16u + y * 3u / 8u - x / 64u + y * 3u / 256u;
        }
        return (int)x;
    }
}

// Fixed point 2D point, port of openbw's xy_t<fp8>.
public struct XyFp8 {
    public Fp X;
    public Fp Y;

    public XyFp8(Fp x, Fp y) { X = x; Y = y; }

    public static bool operator ==(XyFp8 a, XyFp8 b) { return a.X == b.X && a.Y == b.Y; }
    public static bool operator !=(XyFp8 a, XyFp8 b) { return !(a.X == b.X && a.Y == b.Y); }

    public static XyFp8 operator +(XyFp8 a, XyFp8 b) { return new XyFp8(a.X + b.X, a.Y + b.Y); }
    public static XyFp8 operator -(XyFp8 a, XyFp8 b) { return new XyFp8(a.X - b.X, a.Y - b.Y); }

    public static XyFp8 operator *(XyFp8 a, int b) { return new XyFp8(a.X * b, a.Y * b); }
    public static XyFp8 operator /(XyFp8 a, int b) { return new XyFp8(a.X / b, a.Y / b); }
    public static XyFp8 operator /(XyFp8 a, Fp b) { return new XyFp8(a.X / b, a.Y / b); }
}

// Sprite-level state (openbw sprite_t), reduced to the fields the movement
// code touches.
public class Sprite {
    public int Flags;
    public Xy Position;
    public int ElevationLevel;

    // openbw: sprite_t::owner -- the player that owns the sprite, which
    // can differ from the unit's owner for a neutral unit.
    public int Owner;

    public Sprite() {
        Flags = 0;
        Position = new Xy(0, 0);
        ElevationLevel = 4;
        Owner = 0;
    }

    // openbw: bool s_flag(const sprite_t* u, sprite_t::flags_t flag)
    public bool HasFlag(SpriteFlag flag) { return (Flags & (int)flag) != 0; }
    public void SetFlag(SpriteFlag flag) { Flags = Flags | (int)flag; }
    public void UnsetFlag(SpriteFlag flag) { Flags = Flags & ~((int)flag); }
}

// Flingy type (openbw flingy_type_t).
public class FlingyType {
    public int Id;
    public Fp TopSpeed;
    public Fp Acceleration;
    public Fp HaltDistance;
    public Fp TurnRate;
    public int MovementType;

    public FlingyType(int id, Fp topSpeed, Fp acceleration, Fp haltDistance, Fp turnRate, int movementType) {
        Id = id;
        TopSpeed = topSpeed;
        Acceleration = acceleration;
        HaltDistance = haltDistance;
        TurnRate = turnRate;
        MovementType = movementType;
    }
}

// Unit type (openbw unit_type_t), reduced to the fields the movement code needs.
public class UnitType {
    public int Id;
    public FlingyType Flingy;
    public Fp Hitpoints;
    public int ElevationLevel;
    public int Flags;
    public int SightRange;
    public Xy DimensionsFrom;
    public Xy DimensionsTo;
    public int GroupFlags;

    // openbw: unit_type_t::placement_size -- the size of the ground the
    // unit takes when it is placed. The creep layer uses it to work out
    // the area a building covers.
    public Xy PlacementSize;

    // openbw: unit_type_spreads_creep() -- whether this unit type
    // spreads creep around itself.
    public bool SpreadsCreep;

    // openbw: unit_type_t::right_click_action
    //
    // What right-clicking the unit does. 0 means "nothing", 1 is a
    // normal unit, 2 is a factory, 3 is a unit that cannot move (a
    // burrowed lurker), 4 and 5 are the spell casters.
    public int RightClickAction;

    // openbw: unit_type_t::space_provided
    //
    // How much cargo space the unit provides.
    public int SpaceProvided;

    // openbw: unit_type_t::space_required
    //
    // How much cargo space the unit needs.
    public int SpaceRequired;

    public UnitType(int id, FlingyType flingy, int elevationLevel, int flags, int sightRange,
                   Xy dimensionsFrom, Xy dimensionsTo) {
        Id = id;
        Flingy = flingy;
        Hitpoints = Fp.Integer(400);
        ElevationLevel = elevationLevel;
        Flags = flags;
        SightRange = sightRange;
        DimensionsFrom = dimensionsFrom;
        DimensionsTo = dimensionsTo;
        GroupFlags = 0;
        PlacementSize = new Xy(0, 0);
        SpreadsCreep = false;
        RightClickAction = 1;
        SpaceProvided = 0;
        SpaceRequired = 0;
    }
}

// The unit entity: openbw's unit_t, restricted to the fields the movement
// simulation reads or writes.
public class Unit {
    // ---- flingy_t ---------------------------------------------------------
    public Fp Hp;
    public Sprite Sprite;

    public Xy MoveTargetPos;
    public bool HasMoveTargetUnit;

    // openbw: move_target.unit -- the unit the move order points at, as a
    // unit id.
    public int MoveTargetUnitId;
    public Xy NextMovementWaypoint;
    public Xy NextTargetWaypoint;
    public int MovementFlags;

    public Dir Heading;
    public Fp FlingyTurnRate;
    public Dir NextVelocityDirection;
    public FlingyType FlingyType;
    public int FlingyMovementType;

    public Xy Position;
    public XyFp8 ExactPosition;
    public Fp FlingyTopSpeed;
    public Fp CurrentSpeed;
    public Fp NextSpeed;
    public XyFp8 Velocity;
    public Fp FlingyAcceleration;
    public Dir CurrentVelocityDirection;
    public Dir DesiredVelocityDirection;
    public int OrderSignal;

    // ---- unit_t -----------------------------------------------------------
    public int Owner;
    public int OrderId;
    public int OrderState;
    public UnitType UnitType;

    // openbw: unit_t::order_target
    //
    // What the unit's current order points at.
    public OrderTarget OrderTarget;

    // openbw: unit_t::order_process_timer
    public int OrderProcessTimer;

    // openbw: unit_t::order_queue
    //
    // The index of this unit's queue in the order queue pool. The C++
    // keeps the intrusive list inside the unit; here the queue lives in
    // the pool and the unit holds its index.
    public int OrderQueueIndex;

    // ---- the fields the unit status predicates read -----------------------

    // openbw: unit_t::lockdown_timer
    public int LockdownTimer;

    // openbw: unit_t::stasis_timer
    public int StasisTimer;

    // openbw: unit_t::maelstrom_timer
    public int MaelstromTimer;

    // openbw: unit_t::build_queue
    //
    // The C++ keeps the build queue as a list of order_t. Here the unit
    // keeps the count and the type at the front, which is all the unit
    // status predicates read.
    public int BuildQueueCount;

    // openbw: unit_t::build_queue.front()->id
    public int BuildQueueFrontTypeId;

    // openbw: unit_t::building.researching_type
    //
    // The tech type the unit is researching, or -1.
    public int ResearchingTypeId;

    // openbw: unit_t::building.upgrading_type
    //
    // The upgrade type the unit is upgrading, or -1.
    public int UpgradingTypeId;

    // openbw: unit_t::current_build_unit
    //
    // The unit the building is currently building, as a unit id, or -1.
    public int CurrentBuildUnitId;

    // openbw: unit_t::blinded_by
    //
    // The unit that blinded this one, as a unit id, or -1.
    public int BlindedByUnitId;

    // openbw: unit_t::secondary_order_type
    //
    // The unit's secondary order, as an order id.
    public int SecondaryOrderId;

    // openbw: unit_t::building.nydus.exit
    //
    // Whether the nydus canal already has its exit built.
    public bool NydusExit;

    // openbw: unit_t::detected_flags
    //
    // Which owners have already detected this cloaked unit.
    public int DetectedFlags;

    public int UserActionFlags;
    public MovementStates MovementState;
    public int StatusFlagBits;
    public int CarryingFlags;
    public int WireframeRandomizer;
    public int SecondaryOrderState;
    public int MoveTargetTimer;
    public int PathingCollisionCounter;
    public int PathingFlags;

    public int RepulseFlags;
    public Dir RepulseDirection;
    public int RepulseIndex;

    // openbw: unit_t::terrain_no_collision_bounds -- the box around the
    // unit in which the terrain is known to be free. The terrain collision
    // check narrows it on every call.
    public int TerrainNoCollisionFromX;
    public int TerrainNoCollisionFromY;
    public int TerrainNoCollisionToX;
    public int TerrainNoCollisionToY;

    public int UnitIdGeneration;

    // The unit's index in the game's unit table. Together with the
    // generation counter it makes up the unit id.
    public int UnitIdIndex;

    // openbw: unit_t::unit_finder_bounding_box -- the span of the unit
    // in the unit finder. A value of -1 in "to.x" means the unit is not
    // in the finder at all.
    public int UnitFinderFromX;
    public int UnitFinderFromY;
    public int UnitFinderToX;
    public int UnitFinderToY;

    // openbw: unit_t::unit_finder_visited -- one flag per search slot.
    // A unit is reported at most once per search, even though it appears
    // twice in the index.
    public bool[] UnitFinderVisited;

    public Unit() {
        Hp = Fp.Zero();
        Sprite = new Sprite();
        MoveTargetPos = new Xy(0, 0);
        HasMoveTargetUnit = false;
        MoveTargetUnitId = -1;
        NextMovementWaypoint = new Xy(0, 0);
        NextTargetWaypoint = new Xy(0, 0);
        MovementFlags = 0;
        Heading = Dir.Zero();
        FlingyTurnRate = Fp.Zero();
        NextVelocityDirection = Dir.Zero();
        FlingyMovementType = 0;
        Position = new Xy(0, 0);
        ExactPosition = new XyFp8(Fp.Zero(), Fp.Zero());
        FlingyTopSpeed = Fp.Zero();
        CurrentSpeed = Fp.Zero();
        NextSpeed = Fp.Zero();
        Velocity = new XyFp8(Fp.Zero(), Fp.Zero());
        FlingyAcceleration = Fp.Zero();
        CurrentVelocityDirection = Dir.Zero();
        DesiredVelocityDirection = Dir.Zero();
        OrderSignal = 0;
        Owner = 0;
        OrderId = 0;
        OrderState = 0;
        UnitType = null;
        OrderTarget = new OrderTarget();
        OrderProcessTimer = 0;
        OrderQueueIndex = -1;
        LockdownTimer = 0;
        StasisTimer = 0;
        MaelstromTimer = 0;
        BuildQueueCount = 0;
        BuildQueueFrontTypeId = -1;
        ResearchingTypeId = -1;
        UpgradingTypeId = -1;
        CurrentBuildUnitId = -1;
        BlindedByUnitId = -1;
        SecondaryOrderId = (int)Orders.None;
        NydusExit = false;
        DetectedFlags = 0;
        UserActionFlags = 0;
        MovementState = MovementStates.UM_Init;
        StatusFlagBits = 0;
        CarryingFlags = 0;
        WireframeRandomizer = 0;
        SecondaryOrderState = 0;
        MoveTargetTimer = 0;
        PathingCollisionCounter = 0;
        PathingFlags = 0;
        RepulseFlags = 0;
        RepulseDirection = Dir.Zero();
        RepulseIndex = 0;
        TerrainNoCollisionFromX = 0;
        TerrainNoCollisionFromY = 0;
        TerrainNoCollisionToX = 0;
        TerrainNoCollisionToY = 0;
        UnitIdGeneration = 0;
        UnitIdIndex = 0;
        UnitFinderFromX = -1;
        UnitFinderFromY = -1;
        UnitFinderToX = -1;
        UnitFinderToY = -1;
        UnitFinderVisited = new bool[4];
    }

    // ---- status helpers (openbw bwgame.h u_* helpers) ----------------------

    public bool HasStatusFlag(StatusFlag flag) { return (StatusFlagBits & (int)flag) != 0; }
    public void SetStatus(StatusFlag flag) { StatusFlagBits = StatusFlagBits | (int)flag; }
    public void UnsetStatus(StatusFlag flag) { StatusFlagBits = StatusFlagBits & ~((int)flag); }

    // openbw: u_set_status_flag(u, flag, value)
    //
    // Sets or clears a status flag depending on the value.
    public void SetStatus(StatusFlag flag, bool value) {
        if (value) SetStatus(flag);
        else UnsetStatus(flag);
    }

    // ---- geometry ----------------------------------------------------------

    // openbw: rect unit_bounding_box(const unit_t* u, xy origin)
    //
    // The outer box of the unit at the given origin:
    // { origin - from, origin + to + (1, 1) }.
    public Box BoundingBoxAt(int originX, int originY) {
        return new Box(originX - UnitType.DimensionsFrom.X,
                       originX + UnitType.DimensionsTo.X + 1,
                       originY - UnitType.DimensionsFrom.Y,
                       originY + UnitType.DimensionsTo.Y + 1);
    }

    // The inner box of the unit at the given origin: { origin - from,
    // origin + to }.
    public Box InnerBoxAt(int originX, int originY) {
        return new Box(originX - UnitType.DimensionsFrom.X,
                       originX + UnitType.DimensionsTo.X,
                       originY - UnitType.DimensionsFrom.Y,
                       originY + UnitType.DimensionsTo.Y);
    }

    // The box of the unit at its own position. The outer box is one pixel
    // bigger on the far side than the inner one.
    public Box SpriteBox(bool outer) {
        int toX = Position.X + UnitType.DimensionsTo.X;
        int toY = Position.Y + UnitType.DimensionsTo.Y;
        if (outer) {
            toX = toX + 1;
            toY = toY + 1;
        }
        return new Box(Position.X - UnitType.DimensionsFrom.X, toX,
                       Position.Y - UnitType.DimensionsFrom.Y, toY);
    }

    // openbw: bool us_hidden(const thingy_t* u) const
    public bool USHidden() { return Sprite.HasFlag(SpriteFlag.Hidden); }
    public void ClearStatus(StatusFlag flag) { StatusFlagBits = StatusFlagBits & ~(int)flag; }

    public bool UCanMove() { return HasStatusFlag(StatusFlag.CanMove); }
    public bool UCanTurn() { return HasStatusFlag(StatusFlag.CanTurn); }
    public bool UFlying() { return HasStatusFlag(StatusFlag.Flying); }
    public bool UGroundUnit() { return HasStatusFlag(StatusFlag.GroundUnit); }
    public bool UGroundedBuilding() { return HasStatusFlag(StatusFlag.GroundedBuilding); }
    public bool UOrderNotInterruptible() { return HasStatusFlag(StatusFlag.OrderNotInterruptible); }
    public bool UIscriptNobrk() { return HasStatusFlag(StatusFlag.IscriptNobrk); }
    public bool UCollision() { return HasStatusFlag(StatusFlag.Collision); }
    public bool UCompleted() { return HasStatusFlag(StatusFlag.Completed); }
    public bool UImmovable() { return HasStatusFlag(StatusFlag.Immovable); }
    public bool UBurrowed() { return HasStatusFlag(StatusFlag.Burrowed); }
    public bool UInBunker() { return HasStatusFlag(StatusFlag.InBunker); }

    public bool MovementFlag(int flag) { return (MovementFlags & flag) != 0; }
    public void SetMovementFlag(int flag) { MovementFlags = MovementFlags | flag; }
    public void UnsetMovementFlag(int flag) { MovementFlags = MovementFlags & ~flag; }

    public bool UtBuilding() { return UnitType != null && (UnitType.Flags & UnitTypeFlag.Building) != 0; }
    public bool UtTurret() { return UnitType != null && (UnitType.Flags & UnitTypeFlag.Turret) != 0; }
    public bool UtFlyer() { return UnitType != null && (UnitType.Flags & UnitTypeFlag.Flyer) != 0; }

    // openbw: bool unit_is_at_move_target(const flingy_t* u) const {
    //     return u->sprite->position == u->move_target.pos;
    // }
    public bool IsAtMoveTarget() { return Sprite.Position == MoveTargetPos; }
}
