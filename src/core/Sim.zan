    public void StopFlingy(Unit u) {
        if ((u.MovementFlags & 4) != 0) return;
        u.MovementFlags = u.MovementFlags & ~0x10;
        u.MovementFlags = u.MovementFlags & ~0x20;
        u.MovementFlags = u.MovementFlags & ~0x40;
        u.MoveTargetPos = new Xy(u.Position.X, u.Position.Y);
        u.HasMoveTargetUnit = false;
        u.NextMovementWaypoint = new Xy(u.Position.X, u.Position.Y);
        if ((u.MovementFlags & 2) != 0 && u.FlingyMovementType == 0) {
            Fp d = Kin.UnitHaltDistance(u);
            XyFp8 target = u.ExactPosition + Kin.DirectionXY(u.NextVelocityDirection, d);
            Xy xyTarget = Kin.ToXy(target);
            u.MoveTargetPos = xyTarget;
            u.NextMovementWaypoint = xyTarget;
            if (u.Sprite.Position != u.MoveTargetPos) u.MovementFlags = u.MovementFlags | 4;
        }
    }

    // openbw: void stop_unit(unit_t* u) {
    //     if (u->pathing_flags & 2) u->pathing_flags |= 4;
    //     stop_flingy(u);
    //     xy move_target = restrict_move_target_to_valid_bounds(u, u->move_target.pos);
    //     if (u->move_target.pos != move_target) {
    //         u->move_target.pos = move_target;
    //         u->next_movement_waypoint = move_target;
    //     }
    //     u->move_target_timer = 15;
    // }
    public void StopUnit(Unit u) {
        if ((u.PathingFlags & 2) != 0) u.PathingFlags = u.PathingFlags | 4;
        StopFlingy(u);
        // openbw: xy move_target = restrict_move_target_to_valid_bounds(u, u->move_target.pos);
        Xy restricted = RestrictUnitPosToBounds(u.MoveTargetPos, u.UnitType,
                                               new Xy(0, 0), new Xy(MapWidth, MapHeight - 32));
        if (u.MoveTargetPos != restricted) {
            u.MoveTargetPos = restricted;
            u.NextMovementWaypoint = restricted;
        }
        u.MoveTargetTimer = 15;
    }

    // openbw: bool finish_flingy_movement(flingy_t* u, execute_movement_struct& ems) {
    //     bool moved = u->position != ems.position;
    //     u->movement_flags = ems.post_movement_flags;
    //     u->next_speed = u->current_speed;
    //     u->position = ems.position;
    //     u->exact_position = ems.exact_position;
    //     move_sprite(u->sprite, u->position);
    //     update_unit_heading(u, u->current_velocity_direction);
    //     return moved;
    // }
    public bool FinishFlingyMovement(Unit u, Ems ems) {
        bool moved = u.Position != ems.Position;
        u.MovementFlags = ems.PostMovementFlags;
        u.NextSpeed = u.CurrentSpeed;
        u.Position = ems.Position;
        u.ExactPosition = ems.ExactPosition;
        u.Sprite.Position = u.Position;
        Kin.UpdateUnitHeading(u, u.CurrentVelocityDirection);
        return moved;
    }

    // openbw: bool finish_unit_movement(unit_t* u, execute_movement_struct& ems) {
    //     auto prev_pos = u->position;
    //     if (!finish_flingy_movement(u, ems)) return false;
    //     if (tile_index(prev_pos) != tile_index(u->position)) ems.refresh_vision = true;
    //     unit_finder_reinsert(u);
    //     return true;
    // }
    public bool FinishUnitMovement(Unit u, Ems ems) {
        Xy prevPos = u.Position;
        if (!FinishFlingyMovement(u, ems)) return false;
        if (TileIndex(prevPos) != TileIndex(u.Position)) ems.RefreshVision = true;
        // openbw: unit_finder_reinsert(u) -- the unit's box moved, so the
        // spatial index has to follow.
        UnitFinderReinsert(u);
        return true;
    }

    // openbw: void unit_finder_reinsert(unit_t* u)
    //
    // The unit's bounding box in the finder follows its position.
    public void UnitFinderReinsert(Unit u) {
        if (u.UnitFinderToX == -1) return;
        int fromX = u.Position.X - u.UnitType.DimensionsFrom.X;
        int toX = u.Position.X + u.UnitType.DimensionsTo.X;
        int fromY = u.Position.Y - u.UnitType.DimensionsFrom.Y;
        int toY = u.Position.Y + u.UnitType.DimensionsTo.Y;
        Finder.Reinsert(u, fromX, toX, fromY, toY);
    }

    // openbw: size_t tile_index(xy pos) const {
    //     size_t ux = (size_t)pos.x / 32;
    //     size_t uy = (size_t)pos.y / 32;
    //     return uy * game_st.map_tile_width + ux;
    // }
    public int TileIndex(Xy pos) {
        int ux = pos.X / 32;
        int uy = pos.Y / 32;
        return uy * MapTileWidth + ux;
    }

