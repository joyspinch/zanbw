    //     if (u->next_target_waypoint == pos) return;
    //     u->next_target_waypoint = pos;
    // }
    public void SetNextTargetWaypoint(Unit u, Xy pos) {
        if (u.NextTargetWaypoint == pos) return;
        u.NextTargetWaypoint = pos;
    }

