using System;

// openbw: the build rules layer (bwgame.h)
//
// Whether a unit may start building another unit type. The original
// is one big switch over the unit type; this is the same switch, case
// by case, with the same order of the checks.
//
// The state the rules need is passed in rather than reached for: what
// the player has built, what the building is doing, and how many
// fighters it holds.

public class UnitBuildRules {
    // openbw: unit_can_build, the Terran_Marine case.
    private static bool CanBuild_Terran_Marine(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Barracks)) return false;
        if (UnitStatus.UnitIsBuildingAddon(u, s.CurrentBuildCompleted) || UnitStatus.UnitIsBuildingProtossThing(u, s.OrderTargetCompleted)) return false;
        if (!UnitStatus.IsGroundedBuilding(u)) return false;
        return true;
    }

    // openbw: unit_can_build, the Terran_Ghost case.
    private static bool CanBuild_Terran_Ghost(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Barracks)) return false;
        if (UnitStatus.UnitIsBuildingAddon(u, s.CurrentBuildCompleted) || UnitStatus.UnitIsBuildingProtossThing(u, s.OrderTargetCompleted)) return false;
        if (!UnitStatus.IsGroundedBuilding(u)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Terran_Covert_Ops)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Terran_Academy)) return false;
        return true;
    }

    // openbw: unit_can_build, the Terran_Vulture case.
    private static bool CanBuild_Terran_Vulture(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Factory)) return false;
        if (!UnitStatus.IsGroundedBuilding(u)) return false;
        if (UnitStatus.UnitIsBuildingAddon(u, s.CurrentBuildCompleted) || UnitStatus.UnitIsBuildingProtossThing(u, s.OrderTargetCompleted)) return false;
        return true;
    }

    // openbw: unit_can_build, the Terran_Goliath case.
    private static bool CanBuild_Terran_Goliath(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Factory)) return false;
        if (!UnitStatus.IsGroundedBuilding(u)) return false;
        if (UnitStatus.UnitIsBuildingAddon(u, s.CurrentBuildCompleted) || UnitStatus.UnitIsBuildingProtossThing(u, s.OrderTargetCompleted)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Terran_Armory)) return false;
        return true;
    }

    // openbw: unit_can_build, the Terran_Siege_Tank_Tank_Mode case.
    private static bool CanBuild_Terran_Siege_Tank_Tank_Mode(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Factory)) return false;
        if (!UnitStatus.IsGroundedBuilding(u)) return false;
        if (UnitStatus.UnitIsBuildingAddon(u, s.CurrentBuildCompleted) || UnitStatus.UnitIsBuildingProtossThing(u, s.OrderTargetCompleted)) return false;
        if (!s.HasAddon(u, (int)UnitTypes.Terran_Machine_Shop)) return false;
        return true;
    }

