    // openbw: unit_can_build, the Terran_Science_Vessel case.
    private static bool CanBuild_Terran_Science_Vessel(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Starport)) return false;
