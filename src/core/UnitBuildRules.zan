    // openbw: unit_can_build, the Zerg_Hatchery case.
    private static bool CanBuild_Zerg_Hatchery(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Zerg_Drone)) return false;
        if (UnitFlags.Burrowed(u)) return false;
        return true;
    }

    // openbw: unit_can_build, the Zerg_Lair case.
    private static bool CanBuild_Zerg_Lair(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Zerg_Hatchery)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Zerg_Spawning_Pool)) return false;
        if (s.Constructing || UnitStatus.UnitIsResearching(u) || UnitStatus.UnitIsUpgrading(u)) return false;
        return true;
    }

    // openbw: unit_can_build, the Zerg_Hive case.
    private static bool CanBuild_Zerg_Hive(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Zerg_Lair)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Zerg_Queens_Nest)) return false;
        if (s.Constructing || UnitStatus.UnitIsResearching(u) || UnitStatus.UnitIsUpgrading(u)) return false;
        return true;
