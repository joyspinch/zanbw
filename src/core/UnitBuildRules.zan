    private static bool CanBuild_Zerg_Spawning_Pool(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Zerg_Drone)) return false;
        if (UnitFlags.Burrowed(u)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Zerg_Hatchery) && !s.HasUnit(owner, (int)UnitTypes.Zerg_Lair) && !s.HasUnit(owner, (int)UnitTypes.Zerg_Hive)) return false;
        return true;
    }

