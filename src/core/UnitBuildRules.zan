    // openbw: unit_can_build, the Terran_Engineering_Bay case.
    private static bool CanBuild_Terran_Engineering_Bay(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_SCV)) return false;
        if (UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_SCV) && u.OrderId == (int)Orders.ConstructingBuilding) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Terran_Command_Center)) return false;
        return true;
    }

