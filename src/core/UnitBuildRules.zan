        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Protoss_Fleet_Beacon)) return false;
        return true;
    }

    // openbw: unit_can_build, the Protoss_Interceptor case.
    private static bool CanBuild_Protoss_Interceptor(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.UnitIsCarrier(u.UnitType)) return false;
        if (s.Interceptors + s.QueuedFighterUnits >= s.MaxInterceptors) return false;
        return true;
    }

