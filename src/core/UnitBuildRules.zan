    // openbw: bool unit_can_build(const unit_t* u, const unit_type_t* unit_type) const
    //
    // Whether the unit may start building the unit type.
    public static bool UnitCanBuild(Unit u, int unitTypeId, int owner, BuildState s) {
        if (!s.Completed) return false;
        if (s.Disabled) return false;
        if (s.Hallucination) return false;
        if (!s.UnitTypeAllowed) return false;
        if (s.BuildQueueFull) {
            if (s.BuildQueueBackId <= (int)UnitTypes.Spell_Disruption_Web) return false;
        }
        switch (unitTypeId) {
        case (int)UnitTypes.Terran_Marine: return CanBuild_Terran_Marine(u, owner, s);
        case (int)UnitTypes.Terran_Ghost: return CanBuild_Terran_Ghost(u, owner, s);
        case (int)UnitTypes.Terran_Vulture: return CanBuild_Terran_Vulture(u, owner, s);
        case (int)UnitTypes.Terran_Goliath: return CanBuild_Terran_Goliath(u, owner, s);
        case (int)UnitTypes.Terran_Siege_Tank_Tank_Mode: return CanBuild_Terran_Siege_Tank_Tank_Mode(u, owner, s);
        case (int)UnitTypes.Terran_SCV: return CanBuild_Terran_SCV(u, owner, s);
        case (int)UnitTypes.Terran_Wraith: return CanBuild_Terran_Wraith(u, owner, s);
        case (int)UnitTypes.Terran_Science_Vessel: return CanBuild_Terran_Science_Vessel(u, owner, s);
        case (int)UnitTypes.Terran_Dropship: return CanBuild_Terran_Dropship(u, owner, s);
        case (int)UnitTypes.Terran_Battlecruiser: return CanBuild_Terran_Battlecruiser(u, owner, s);
        case (int)UnitTypes.Terran_Firebat: return CanBuild_Terran_Firebat(u, owner, s);
        case (int)UnitTypes.Terran_Nuclear_Missile: return CanBuild_Terran_Nuclear_Missile(u, owner, s);
        case (int)UnitTypes.Terran_Medic: return CanBuild_Terran_Medic(u, owner, s);
        case (int)UnitTypes.Terran_Valkyrie: return CanBuild_Terran_Valkyrie(u, owner, s);
        case (int)UnitTypes.Zerg_Zergling: return CanBuild_Zerg_Zergling(u, owner, s);
        case (int)UnitTypes.Zerg_Hydralisk: return CanBuild_Zerg_Hydralisk(u, owner, s);
        case (int)UnitTypes.Zerg_Ultralisk: return CanBuild_Zerg_Ultralisk(u, owner, s);
