    // openbw: unit_can_build, the Terran_Command_Center case.
    private static bool CanBuild_Terran_Command_Center(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_SCV)) return false;
        if (UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_SCV) && u.OrderId == (int)Orders.ConstructingBuilding) return false;
        return true;
    }

    // openbw: unit_can_build, the Terran_Comsat_Station case.
    private static bool CanBuild_Terran_Comsat_Station(Unit u, int owner, BuildState s) {
        if (!UnitTypeIds.IsId(u.UnitType, (int)UnitTypes.Terran_Command_Center)) return false;
        if (UnitFlags.Building(u.UnitType) && u.BuildingAddonId >= 0) return false;
        if (s.Constructing || UnitStatus.UnitIsResearching(u) || UnitStatus.UnitIsUpgrading(u)) return false;
        if (!s.HasCompletedUnit(owner, (int)UnitTypes.Terran_Academy)) return false;
        return true;
    }

