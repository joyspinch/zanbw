using System;

// openbw: game_types.h::tile_t -- one map tile.
//
// The visibility layer keeps two byte masks per tile: which players can
// currently see it, and which players have ever seen it. Both are bit
// masks over the twelve players.
public class Tile {
    public int Visible;
    public int Explored;
    public int Flags;

    public Tile() {
        Visible = 0;
        Explored = 0;
        Flags = 0;
    }
}

// One map tile, with everything the map layers need to know about it.
// The engine keeps the terrain in a few parallel arrays; here they live
// in one entity so the tile cannot get out of sync with itself.
public class MapTile {
    // The visibility masks and the terrain flags.
    public Tile Tile;

    // openbw: st.tiles_mega_tile_index -- the mega tile the terrain
    // function picked for this tile.
    public int MegaTileIndex;

    // openbw: game_st.gfx_tiles -- the graphics tile id. Its raw value
    // splits into a group index and a subtile index.
    public int GfxTile;

    public MapTile() {
        Tile = new Tile();
        MegaTileIndex = 0;
        GfxTile = 0;
    }
}

// The tile grid plus the tables the map layers read: the graphics-side
// tile table and the cv5 / vf4 tables.
public class TileMap {
    public int MapTileWidth;
    public int MapTileHeight;

    // The tiles, in row-major order: index = y * MapTileWidth + x.
    public List<MapTile> Tiles;

    // openbw: game_st.cv5 -- per group, the mega tile index of each of
    // the 16 subtiles.
    public List<int> Cv5;

    // openbw: game_st.vf4 -- per mega tile, 16 walkability flags.
    public List<int> Vf4;

    public TileMap(int tileWidth, int tileHeight) {
        MapTileWidth = tileWidth;
        MapTileHeight = tileHeight;
        Tiles = new List<MapTile>();
        Cv5 = new List<int>();
        Vf4 = new List<int>();
    }

    public int TileIndex(int posX, int posY) {
        return (posY / 32) * MapTileWidth + (posX / 32);
    }

    // The tile at a pixel position. The C++'s tile_index() errors on
    // an out-of-bounds position; here the caller is expected to have
    // checked.
    public Tile TileAt(Xy position) {
        return Tiles[TileIndex(position.X, position.Y)].Tile;
    }
}
