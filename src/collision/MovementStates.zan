using System;

// The path-following movement states.
//
// Port of openbw/bwgame.h, movement_UM_*. See StateMachine.zan for the
// file map. Every state returns true when the dispatcher should run the
// loop again with the (possibly changed) movement state.

public class MovementStatesImpl {
    public StateMachine M;
    public Sim Sim;
    public Regions R;
    public PathProgress Pathing;
    public Unit U;

    public MovementStatesImpl(StateMachine m) {
        M = m;
        Sim = m.Sim;
        R = m.R;
        Pathing = m.Pathing;
        U = m.U;
    }

    // openbw: void set_unit_immovable(unit_t* u)
    public void SetUnitImmovable() {
        Kin.SetNextSpeed(U, Fp.Zero());
        Sim.StopUnit(U);
        Pathing.SetUnitMoveTarget(U.Sprite.Position.X, U.Sprite.Position.Y);
        U.SetStatus(StatusFlag.Immovable);
        U.UserActionFlags = U.UserActionFlags & ~2;
    }

    // openbw: void update_unit_pathing_collision(unit_t* u)
    public void UpdateUnitPathingCollision() {
        if ((~U.MovementFlags & 2) != 0) return;
        if (U.PathingCollisionCounter <= 2) return;
        if (U.UOrderNotInterruptible()) return;
        if (U.UIscriptNobrk()) return;
        U.MovementFlags = U.MovementFlags & ~2;
    }

    // ---- states ------------------------------------------------------------

    // openbw: bool movement_UM_Init(unit_t* u, execute_movement_struct& ems) {
    //     u->pathing_flags &= ~(1 | 2);
    //     if (u->sprite->elevation_level < 12) u->pathing_flags |= 1;
    //     u->terrain_no_collision_bounds = {{0, 0}, {0, 0}};
    //     int next_state = movement_states::UM_Lump;
    //     if (!ut_turret(u) && u_iscript_nobrk(u)) next_state = movement_states::UM_InitSeq;
    //     else if (!u->sprite || unit_dead(u)) next_state = movement_states::UM_Lump;
    //     else if (u_in_bunker(u)) next_state = movement_states::UM_Bunker;
    //     else if (us_hidden(u)) { ... next_state = movement_states::UM_Hidden; }
    //     else if (u_burrowed(u)) next_state = movement_states::UM_Lump;
    //     else if (u_can_move(u)) {
    //         next_state = u->pathing_flags & 1 ? movement_states::UM_AtRest : movement_states::UM_Flyer;
    //     } else if (u_can_turn(u)) { ... }
    //     u->movement_state = next_state;
    //     return true;
    // }
    public bool UmInit(Ems ems) {
        U.PathingFlags = U.PathingFlags & ~3;
        if (U.Sprite.ElevationLevel < 12) U.PathingFlags = U.PathingFlags | 1;
        U.TerrainNoCollisionFromX = 0;
        U.TerrainNoCollisionFromY = 0;
        U.TerrainNoCollisionToX = 0;
        U.TerrainNoCollisionToY = 0;
        MovementStates next = MovementStates.UM_Lump;
        if (!U.UtTurret() && U.UIscriptNobrk()) {
            next = MovementStates.UM_InitSeq;
        } else if (U.Sprite == null) {
            next = MovementStates.UM_Lump;
        } else if (U.UInBunker()) {
            next = MovementStates.UM_Bunker;
        } else if (U.UBurrowed()) {
            next = MovementStates.UM_Lump;
        } else if (U.UCanMove()) {
            next = (U.PathingFlags & 1) != 0 ? MovementStates.UM_AtRest : MovementStates.UM_Flyer;
        } else if (U.UCanTurn()) {
            next = U.UtTurret() ? MovementStates.UM_Turret : MovementStates.UM_BldgTurret;
        }
        U.MovementState = next;
        return true;
    }

    // openbw: bool movement_UM_CheckIllegal(unit_t* u, execute_movement_struct& ems)
    //
    // The unit stands in an illegal position: the terrain does not fit it,
    // or another unit is in the way. The state looks for a legal position
    // to move to and walks there with a single step path.
    public bool UmCheckIllegal(Ems ems) {
        U.ClearStatus(StatusFlag.Collision);
        if (CheckIllegal()) {
            U.PathingFlags = U.PathingFlags | 2;
            U.MovementState = MovementStates.UM_MoveToLegal;
            return false;
        }
        U.PathingFlags = U.PathingFlags & ~6;
        if (M.IsAtMoveTarget() || M.MovementFlag(4)) {
            U.MovementState = MovementStates.UM_AtRest;
        } else {
            U.MovementState = MovementStates.UM_AnotherPath;
        }
        return true;
    }

    // openbw: the check_illegal lambda of movement_UM_CheckIllegal.
    //
    // True when the unit was given a legal spot to walk to.
    private bool CheckIllegal() {
        int posX = U.Sprite.Position.X;
        int posY = U.Sprite.Position.Y;
        if (!U.UGroundUnit()) return false;
        Unit blockingUnit = null;
        if (!M.IsBlockedWithUnit(U, posX, posY, out blockingUnit)) return false;
        if (U.UOrderNotInterruptible() || U.UIscriptNobrk() || M.MovementFlag(8)) {
            U.SetStatus(StatusFlag.Collision);
            return false;
        }
        int moveToX = posX;
        int moveToY = posY;
        if (M.UnitTypeCanFitAt(U.UnitType, posX, posY)) {
            // The terrain is fine, another unit is in the way. Steer around
            // it.
            if (blockingUnit != null) {
                FindMoveTo(blockingUnit, moveToX, moveToY);
            }
        } else {
            // The terrain does not fit the unit: look for a legal spot.
            int[] legal = FindLegalPosition(posX, posY);
            moveToX = legal[0];
            moveToY = legal[1];
        }
        int[] restricted = Pathing.RestrictMoveTarget(moveToX, moveToY);
        moveToX = restricted[0];
        moveToY = restricted[1];
        if (moveToX == posX && moveToY == posY) {
            U.SetStatus(StatusFlag.Collision);
            return false;
        }
        Pathing.FreePath();
        if (M.IsAtMoveTarget() || M.MovementFlag(4)) {
            Pathing.SetUnitMoveTarget(moveToX, moveToY);
        } else {
            Pathing.SetNextTargetWaypoint(moveToX, moveToY);
            if (U.NextMovementWaypoint.X != moveToX || U.NextMovementWaypoint.Y != moveToY) {
                U.NextMovementWaypoint = new Xy(moveToX, moveToY);
                M.SetMovementFlag(1);
            }
        }
        Pathing.Current = Pathing.CreateSingleStepPath(posX, posY, moveToX, moveToY);
        U.TerrainNoCollisionFromX = 0;
        U.TerrainNoCollisionFromY = 0;
        U.TerrainNoCollisionToX = 0;
        U.TerrainNoCollisionToY = 0;
        return true;
    }

    // openbw: the find_move_to lambda of movement_UM_CheckIllegal.
    //
    // The unit fits where it stands but another unit is in the way. Work
    // out where to step aside to.
    private void FindMoveTo(Unit blockingUnit, out int moveToX, out int moveToY) {
        int posX = U.Sprite.Position.X;
        int posY = U.Sprite.Position.Y;
        moveToX = posX;
        moveToY = posY;
        bool otherUnitIsMoving = false;
        if (U.UCanMove()
            && (!blockingUnit.IsAtMoveTarget()
                || blockingUnit.MovementState == MovementStates.UM_CheckIllegal
                || blockingUnit.MovementState == MovementStates.UM_MoveToLegal)) {
            otherUnitIsMoving = true;
            if (Sim.Rng.Rand(50, 0, 31) < 24) return;
        } else {
            // The blocking unit is not moving. Look for a spot next to it
            // that the unit can slip into.
            int[] initialRect = SuperBb(blockingUnit, U);
            List<Box> rects = new List<Box>();
            int topFromX = initialRect[0];
            int topFromY = initialRect[1];
            int topToX = initialRect[2];
            int topToY = initialRect[3];
            // The four rects are the four sides of the blocking unit: the
            // top, the right, the bottom and the left.
            int[] fromX = new int[4];
            int[] fromY = new int[4];
            int[] toX = new int[4];
            int[] toY = new int[4];
            for (int i = 0; i < 4; ++i) {
                fromX[i] = topFromX;
                fromY[i] = topFromY;
                toX[i] = topToX;
                toY[i] = topToY;
            }
            toY[0] = topFromY;
            fromX[1] = topToX;
            fromY[2] = topToY;
            toX[3] = topFromX;
            for (int i = 0; i < 4; ++i) {
                int fX = fromX[i];
                int fY = fromY[i];
                int tX = toX[i];
                int tY = toY[i];
                if (M.GetUniqueSidedPositionsWithinBounds(ref fX, ref fY, ref tX, ref tY,
                        U.TerrainNoCollisionFromX, U.TerrainNoCollisionFromY,
                        U.TerrainNoCollisionToX, U.TerrainNoCollisionToY)) {
                    rects.Add(new Box(fX, tX, fY, tY));
                }
            }
            // openbw: find_bb / find_units_noexpand narrow the search down
            // to the units that are actually next to the blocking unit.
            int findFromX = topFromX - U.UnitType.DimensionsFrom.X;
            int findFromY = topFromY - U.UnitType.DimensionsFrom.Y;
            int findToX = topToX + U.UnitType.DimensionsTo.X;
            int findToY = topToY + U.UnitType.DimensionsTo.Y;
            List<Unit> neighbours = Sim.Finder.Find(Sim, findFromX, findToX, findFromY, findToY, false);
            for (int i = 0; i < neighbours.Count; ++i) {
                Unit n = neighbours[i];
                if (Pathfinder.UnitCanCollideWithMoving(Sim, U, n)) {
                    int[] bounds = SuperBb(n, U);
                    List<Box> narrowed = new List<Box>();
                    for (int j = 0; j < rects.Count; ++j) {
                        Box v = rects[j];
                        int fX = v.FromX;
                        int fY = v.FromY;
                        int tX = v.ToX;
                        int tY = v.ToY;
                        if (M.GetUniqueSidedPositionsWithinBounds(ref fX, ref fY, ref tX, ref tY,
                                bounds[0], bounds[1], bounds[2], bounds[3])) {
                            narrowed.Add(new Box(fX, tX, fY, tY));
                        }
                    }
                    rects = narrowed;
                }
            }
            int bestDistance = 9999;
            int bestX = posX;
            int bestY = posY;
            for (int i = 0; i < rects.Count; ++i) {
                Box v = rects[i];
                int x = posX;
                int y = posY;
                if (x > v.ToX) x = v.ToX;
                else if (x < v.FromX) x = v.FromX;
                if (y > v.ToY) y = v.ToY;
                else if (y < v.FromY) y = v.FromY;
                int distance = PathProgress.XyLength(x - posX, y - posY);
                if (distance < bestDistance) {
                    bestDistance = distance;
                    bestX = x;
                    bestY = y;
                }
            }
            if (bestDistance != 9999) {
                if (M.UnitTypeCanFitAt(U.UnitType, bestX, bestY)
                    && !M.IsBlocked(U, bestX, bestY)
                    && M.IsReachable(posX, posY, bestX, bestY)) {
                    moveToX = bestX;
                    moveToY = bestY;
                    return;
                }
            }
        }
        // No free spot found: step in the current direction, and if that
        // does not work, wobble around the current position.
        Dir dir = U.NextVelocityDirection + Dir.FromRaw(16 * Sim.Rng.Rand(50, -3, 3));
        Fp length = Fp.Integer(Sim.Rng.Rand(50, 2, 4) * 4);
        if (!otherUnitIsMoving && blockingUnit.UGroundedBuilding()) length = length * Fp.Integer(3);
        XyFp8 delta = Kin.DirectionXY(dir, length);
        int newX = posX + Kin.ToXy(delta).X;
        int newY = posY + Kin.ToXy(delta).Y;
        if (!M.IsBlocked(U, newX, newY) && M.IsReachable(posX, posY, newX, newY)) {
            moveToX = newX;
            moveToY = newY;
            return;
        }
        if (PathProgress.XyLength(U.MoveTargetPos.X - posX, U.MoveTargetPos.Y - posY) <= 32
            || Sim.Rng.Rand(50, 0, 31) >= 24) {
            moveToX = posX + 16 * Sim.Rng.Rand(50, -2, 2);
            moveToY = posY + 16 * Sim.Rng.Rand(50, -2, 2);
        } else {
            dir = Kin.XyDirection(new Xy(U.MoveTargetPos.X - posX, U.MoveTargetPos.Y - posY))
                + Dir.FromRaw(16 * Sim.Rng.Rand(50, -1, 1));
            length = Fp.Integer(8 + Sim.Rng.Rand(50, 0, 2) * 4);
            if (!otherUnitIsMoving && blockingUnit.UGroundedBuilding()) length = length * Fp.Integer(3);
            XyFp8 d2 = Kin.DirectionXY(dir, length);
            moveToX = posX + Kin.ToXy(d2).X;
            moveToY = posY + Kin.ToXy(d2).Y;
        }
        int fromX2 = moveToX - U.UnitType.DimensionsFrom.X;
        int fromY2 = moveToY - U.UnitType.DimensionsFrom.Y;
        int toX2 = moveToX + U.UnitType.DimensionsTo.X;
        int toY2 = moveToY + U.UnitType.DimensionsTo.Y;
        if (!M.IsInInnerMapBounds(fromX2, fromY2, toX2, toY2) || !M.IsReachable(posX, posY, moveToX, moveToY)) {
            moveToX = posX;
            moveToY = posY;
            return;
        }
        Unit blockedBy = null;
        if (M.IsBlockedWithUnit(U, moveToX, moveToY, out blockedBy)) {
            if (blockedBy == null) {
                moveToX = posX;
                moveToY = posY;
            } else if (otherUnitIsMoving && !blockingUnit.UCanMove()) {
                moveToX = posX;
                moveToY = posY;
            }
        }
    }

    // openbw: the super_bb lambda of the find_move_to lambda
    private int[] SuperBb(Unit a, Unit b) {
        int fromX = a.Position.X - a.UnitType.DimensionsFrom.X;
        int fromY = a.Position.Y - a.UnitType.DimensionsFrom.Y;
        int toX = a.Position.X + a.UnitType.DimensionsTo.X;
        int toY = a.Position.Y + a.UnitType.DimensionsTo.Y;
        fromX = fromX - b.UnitType.DimensionsTo.X - 1;
        fromY = fromY - b.UnitType.DimensionsTo.Y - 1;
        toX = toX + b.UnitType.DimensionsFrom.X + 1;
        toY = toY + b.UnitType.DimensionsFrom.Y + 1;
        return new int[] { fromX, fromY, toX, toY };
    }

    // openbw: the region based search for a legal position in
    // movement_UM_CheckIllegal.
    private int[] FindLegalPosition(int posX, int posY) {
        int regionIndex = Pathing.GetRegionAt(posX, posY);
        Region r = R.RegionsList[regionIndex];
        if (r.Walkable()) {
            int centerX = r.CenterXRaw >> 8;
            int centerY = r.CenterYRaw >> 8;
            int dir = Kin.XyDirection(new Xy(centerX - posX, centerY - posY)).RawValue()
                + 16 * Sim.Rng.Rand(50, -2, 2);
            Fp length = Fp.Integer(Sim.Rng.Rand(50, 2, 4) * 8);
            Fp centerLength = Fp.Integer(PathProgress.XyLength(centerX - posX, centerY - posY));
            // openbw: the 1_fp8 literal is the raw value 1, not one whole
            // pixel.
            if (length > centerLength - Fp.RawLiteral(1)) length = centerLength - Fp.RawLiteral(1);
            XyFp8 delta = Kin.DirectionXY(Dir.FromRaw(dir), length);
            Xy target = Kin.ToXy(Kin.ToXyFp8(new Xy(posX, posY)) + delta);
            if (!M.IsReachable(posX, posY, target.X, target.Y)) return new int[] { posX, posY };
            return new int[] { target.X, target.Y };
        }
        int bestDistance = 2147483647;
        Region bestRegion = null;
        int lastCenterX = 0;
        int lastCenterY = 0;
        foreach (int n in r.WalkableNeighbors) {
            Region nr = R.RegionsList[n];
            int ncx = nr.CenterXRaw >> 8;
            int ncy = nr.CenterYRaw >> 8;
            lastCenterX = ncx;
            lastCenterY = ncy;
            int distance = PathProgress.XyLength(ncx - posX, ncy - posY);
            if (distance < bestDistance) {
                bestDistance = distance;
                bestRegion = nr;
            }
        }
        if (bestRegion != null) {
            bool maybeOutside = false;
            if (posX + 32 < bestRegion.AreaFromX) maybeOutside = true;
            if (posX - 32 >= bestRegion.AreaToX) maybeOutside = true;
            if (posY + 32 < bestRegion.AreaFromY) maybeOutside = true;
            if (posY - 32 >= bestRegion.AreaToY) maybeOutside = true;
            if (maybeOutside) {
                Dir dir = Kin.XyDirection(new Xy(lastCenterX - posX, lastCenterY - posY));
                XyFp8 delta = Kin.DirectionXY(dir, Fp.Integer(64));
                Xy target = Kin.ToXy(Kin.ToXyFp8(new Xy(posX, posY)) + delta);
                return new int[] { target.X, target.Y };
            }
            int[] adjusted = Pathing.AdjustDestination(bestRegion.Index, posX, posY);
            if (adjusted[0] == posX && adjusted[1] == posY) {
                return new int[] { posX, posY - 64 };
            }
            return adjusted;
        }
        if (r.NonWalkableNeighbors.Count > 0) {
            int randomIndex = Sim.Rng.Rand(50, 0, r.NonWalkableNeighbors.Count - 1);
            Region n = R.RegionsList[r.NonWalkableNeighbors[randomIndex]];
            int ncx = n.CenterXRaw >> 8;
            int ncy = n.CenterYRaw >> 8;
            int length = PathProgress.XyLength(ncx - posX, ncy - posY);
            if (length > 64) length = 64;
            Dir dir = Kin.XyDirection(new Xy(ncx - posX, ncy - posY));
            XyFp8 delta = Kin.DirectionXY(dir, Fp.Integer(length));
            Xy target = Kin.ToXy(Kin.ToXyFp8(new Xy(posX, posY)) + delta);
            return new int[] { target.X, target.Y };
        }
        return new int[] { posX, posY };
    }

    // openbw: bool movement_UM_AtRest(unit_t* u, execute_movement_struct& ems)
    public bool UmAtRest(Ems ems) {
        if (!M.IsAtMoveTarget()) {
            if (U.PathingCollisionCounter != 0) {
                if (U.PathingCollisionCounter > 2) U.PathingCollisionCounter = 2;
                else U.PathingCollisionCounter--;
            }
        } else {
            U.PathingCollisionCounter = 0;
        }
        bool goingToNextWaypoint = false;
        if (GoToNextWaypoint()) {
            goingToNextWaypoint = true;
            Sim.UpdateUnitMovementValues(U, ems);
            // openbw: check_ground_unit_movement_unit_collision(u, ems) ||
            //     check_unit_movement_terrain_collision(u, ems)
            if (M.CheckGroundUnitMovementUnitCollision(ems.Position.X, ems.Position.Y) != null
                || M.CheckTerrainCollision(ems.Position.X - U.Position.X, ems.Position.Y - U.Position.Y)) {
                Kin.SetNextSpeed(U, Fp.Zero());
                U.MovementFlags = ems.PostMovementFlags;
                Kin.UpdateUnitHeading(U, U.CurrentVelocityDirection);
                if (ems.StoppingMovement) {
                    // openbw: sprite_run_anim(u->sprite, WalkingToIdle)
                } else if (ems.StartingMovement) {
                    // openbw: sprite_run_anim(u->sprite, Walking)
                }
                Pathing.SetFlingyMoveTarget(U.Sprite.Position.X, U.Sprite.Position.Y);
                Sim.StopUnit(U);
            } else {
                Sim.FinishUnitMovement(U, ems);
            }
        }
        if (U.UCollision() && U.UGroundUnit()) {
            U.MovementState = MovementStates.UM_CheckIllegal;
            return false;
        }
        if (!M.IsAtMoveTarget() && !M.MovementFlag(4)) {
            U.MovementState = MovementStates.UM_StartPath;
            return true;
        }
        if (!goingToNextWaypoint) {
            U.NextSpeed = Fp.Zero();
            if (U.CurrentSpeed != Fp.Zero()) {
                U.CurrentSpeed = Fp.Zero();
                U.Velocity = new XyFp8(Fp.Zero(), Fp.Zero());
            }
            Sim.SetNextTargetWaypoint(U, new Xy(U.Sprite.Position.X, U.Sprite.Position.Y));
            U.MovementState = MovementStates.UM_Dormant;
        }
        return false;
    }

    // openbw: the go_to_next_waypoint lambda of movement_UM_AtRest
    private bool GoToNextWaypoint() {
        if (M.MovementFlag(4)) return true;
        if (M.IsAtMoveTarget()) {
            if (M.MovementFlag(2)) return true;
            if (U.Position != U.NextTargetWaypoint) {
                Dir dir = Kin.XyDirection(new Xy(U.NextTargetWaypoint.X - U.Position.X,
                                                U.NextTargetWaypoint.Y - U.Position.Y));
                if (U.Heading != dir) return true;
                if (U.NextVelocityDirection != dir) return true;
            }
        }
        return false;
    }

    // openbw: bool movement_UM_Dormant(unit_t* u, execute_movement_struct& ems)
    public bool UmDormant(Ems ems) {
        bool rest = false;
        if (U.UCollision() && U.UGroundUnit()) rest = true;
        if (!M.IsAtMoveTarget()) rest = true;
        if (U.Position != U.NextTargetWaypoint) rest = true;
        if (rest) {
            U.MovementState = MovementStates.UM_AtRest;
            return true;
        }
        return false;
    }

    // openbw: bool movement_UM_AtMoveTarget(unit_t* u, execute_movement_struct& ems)
    public bool UmAtMoveTarget(Ems ems) {
        Pathing.FreePath();
        if (U.NextMovementWaypoint != U.MoveTargetPos) {
            U.NextMovementWaypoint = new Xy(U.MoveTargetPos.X, U.MoveTargetPos.Y);
        }
        if (!U.UGroundUnit() || M.MovementFlag(4)) {
            U.MovementState = MovementStates.UM_AtRest;
        } else {
            U.MovementState = MovementStates.UM_CheckIllegal;
        }
        return true;
    }

    // openbw: bool movement_UM_NewMoveTarget(unit_t* u, execute_movement_struct& ems)
    public bool UmNewMoveTarget(Ems ems) {
        if (Pathing.Current != null) {
            Pathing.Current.StateFlags = Pathing.Current.StateFlags & ~1;
        }
        if (!M.UnitUpdatePathMovementState(true)) {
            Pathing.FreePath();
            U.MovementState = MovementStates.UM_Repath;
        }
        return true;
    }

    // openbw: bool movement_UM_AnotherPath(unit_t* u, execute_movement_struct& ems)
    public bool UmAnotherPath(Ems ems) {
        if (Pathing.UnitPathTo(U.MoveTargetPos.X, U.MoveTargetPos.Y,
                Sim.HasConsiderCollisionWithUnit, Sim.ConsiderCollisionWithUnitId)) {
            U.MovementState = MovementStates.UM_FollowPath;
        } else {
            U.MovementState = MovementStates.UM_FailedPath;
        }
        return false;
    }

    // openbw: bool movement_UM_StartPath(unit_t* u, execute_movement_struct& ems)
    public bool UmStartPath(Ems ems) {
        if (Pathing.UnitPathTo(U.MoveTargetPos.X, U.MoveTargetPos.Y,
                Sim.HasConsiderCollisionWithUnit, Sim.ConsiderCollisionWithUnitId)) {
            MovementStates next = MovementStates.UM_FollowPath;
            if ((U.UserActionFlags & 2) != 0) {
                U.UserActionFlags = U.UserActionFlags & ~2;
                if (U.FlingyMovementType == 2) {
                    // openbw: u->path->delay = lcg_rand(51, 0, 2);
                    Pathing.Current.Delay = Sim.Rng.Rand(51, 0, 2);
                    next = MovementStates.UM_UIOrderDelay;
                }
            }
            U.MovementState = next;
            return true;
        }
        U.MovementState = MovementStates.UM_FailedPath;
        return false;
    }

    // openbw: bool movement_UM_FollowPath(unit_t* u, execute_movement_struct& ems)
    public bool UmFollowPath(Ems ems) {
        if (M.UnitUpdatePathMovementState(true)) return true;
        if (!Pathing.UnitPathTo(U.MoveTargetPos.X, U.MoveTargetPos.Y)) {
            U.MovementState = MovementStates.UM_AnotherPath;
            return true;
        }
        Fp speed = U.NextSpeed;
        Sim.UpdateUnitMovementValues(U, ems);
        if (U.FlingyMovementType == 0) speed = U.CurrentSpeed;
        // openbw: check_ground_unit_movement_unit_collision(u, ems) --
        // only ground units collide with other units.
        Unit collisionUnit = null;
        if (U.UGroundUnit()) {
            collisionUnit = Collision.CheckUnitMovementUnitCollision(Sim, U, ems.Position.X, ems.Position.Y);
        }
        if (collisionUnit != null) {
            bool fixCollision = false;
            if (M.CheckTerrainCollision(ems.Position.X - U.Position.X, ems.Position.Y - U.Position.Y)) {
                fixCollision = true;
            } else if (U.Velocity.X < Fp.RawLiteral(32) && U.Velocity.Y < Fp.RawLiteral(32)) {
                fixCollision = true;
            } else if (ems.Speed != U.CurrentSpeed) {
                fixCollision = true;
            } else {
                // openbw: the half-speed and quarter-speed probes. A unit
                // that still collides at a quarter of the speed is really
                // in the way.
                Xy pos = ems.Position;
                XyFp8 exactPos = ems.ExactPosition;
                ems.ExactPosition = U.ExactPosition + U.Velocity / 2;
                ems.Position = Kin.ToXy(ems.ExactPosition);
                if (Collision.CheckUnitMovementUnitCollision(Sim, U, ems.Position.X, ems.Position.Y) != null) {
                    ems.ExactPosition = U.ExactPosition + U.Velocity / 4;
                    ems.Position = Kin.ToXy(ems.ExactPosition);
                        if (Collision.CheckUnitMovementUnitCollision(Sim, U, ems.Position.X, ems.Position.Y) != null) {
                        ems.Position = pos;
                        ems.ExactPosition = exactPos;
                        fixCollision = true;
                    }
                }
            }
            if (fixCollision) {
                if (Pathing.Current != null) {
                    Pathing.Current.LastCollisionUnit = Sim.GetUnitId(collisionUnit);
                    Pathing.Current.HasLastCollisionUnit = true;
                    Pathing.Current.LastCollisionSpeed = speed;
                }
                U.MovementState = MovementStates.UM_FixCollision;
                return true;
            }
        } else {
            if (M.CheckTerrainCollision(ems.Position.X - U.Position.X, ems.Position.Y - U.Position.Y)) {
                if (Pathing.Current != null) Pathing.Current.LastCollisionSpeed = speed;
                U.MovementState = MovementStates.UM_FixTerrain;
                return true;
            }
        }
        if (U.Sprite.Position != ems.Position) {
            if (U.PathingCollisionCounter != 0) {
                if (U.PathingCollisionCounter > 2) U.PathingCollisionCounter = 2;
                else U.PathingCollisionCounter--;
            }
        }
        Sim.FinishUnitMovement(U, ems);
        if (M.IsAtMoveTarget()) {
            U.MovementState = MovementStates.UM_AtMoveTarget;
        } else {
            if (Pathing.Current != null) {
                if (Pathing.Current.Delay != 0) {
                    Pathing.Current.Delay--;
                } else {
                    Pathing.Current.Delay = 30;
                    U.MovementState = MovementStates.UM_ScoutPath;
                }
            }
        }
        return false;
    }

    // openbw: bool movement_UM_ScoutPath(unit_t* u, execute_movement_struct& ems)
    public bool UmScoutPath(Ems ems) {
        if (M.UnitUpdatePathMovementState(true)) return true;
        U.MovementState = MovementStates.UM_FollowPath;
        return true;
    }

    // openbw: bool movement_UM_Repath(unit_t* u, execute_movement_struct& ems)
    public bool UmRepath(Ems ems) {
        // openbw: const unit_t* collision_unit = st.consider_collision_with_unit_bug;
        bool hasCollisionUnit = Sim.HasConsiderCollisionWithUnit;
        int collisionUnitId = Sim.ConsiderCollisionWithUnitId;
        if (Pathing.Current != null) {
            hasCollisionUnit = Pathing.Current.HasLastCollisionUnit;
            collisionUnitId = Pathing.Current.LastCollisionUnit;
            Pathing.FreePath();
        }
        Sim.HasConsiderCollisionWithUnit = false;
        if (Pathing.UnitPathTo(U.MoveTargetPos.X, U.MoveTargetPos.Y,
                hasCollisionUnit, collisionUnitId)) {
            U.MovementState = MovementStates.UM_FollowPath;
        } else {
            U.MovementState = MovementStates.UM_FailedPath;
        }
        return true;
    }

    // openbw: bool movement_UM_FailedPath(unit_t* u, execute_movement_struct& ems)
    public bool UmFailedPath(Ems ems) {
        U.PathingCollisionCounter = 10;
        UpdateUnitPathingCollision();
        U.MovementState = MovementStates.UM_RetryPath;
        return false;
    }

    // openbw: bool movement_UM_RetryPath(unit_t* u, execute_movement_struct& ems)
    public bool UmRetryPath(Ems ems) {
        if (M.UnitUpdatePathMovementState(false)) return true;
        if (U.PathingCollisionCounter < 20) {
            U.PathingCollisionCounter++;
            return false;
        }
        if (Pathing.UnitPathTo(U.MoveTargetPos.X, U.MoveTargetPos.Y,
                Sim.HasConsiderCollisionWithUnit, Sim.ConsiderCollisionWithUnitId)) {
            U.MovementState = MovementStates.UM_FollowPath;
            return true;
        }
        SetUnitImmovable();
        U.MovementState = MovementStates.UM_AtMoveTarget;
        return false;
    }

    // openbw: bool movement_UM_FixTerrain(unit_t* u, execute_movement_struct& ems)
    public bool UmFixTerrain(Ems ems) {
        if (U.PathingCollisionCounter < 255) U.PathingCollisionCounter++;
        if (M.UnitUpdatePathMovementState(true)) return true;
        Kin.SetNextSpeed(U, Pathing.Current.LastCollisionSpeed);
        Sim.UpdateUnitMovementValues(U, ems);
        // openbw: the terrain collision is checked before the unit one.
        if (M.CheckTerrainCollision(ems.Position.X - U.Position.X, ems.Position.Y - U.Position.Y)
            || Collision.CheckUnitMovementUnitCollision(Sim, U, ems.Position.X, ems.Position.Y) != null) {
            UpdateUnitPathingCollision();
            Dir toWaypoint = Kin.XyDirection(new Xy(U.NextMovementWaypoint.X - U.Sprite.Position.X,
                                                    U.NextMovementWaypoint.Y - U.Sprite.Position.Y));
            if (U.NextVelocityDirection == toWaypoint) {
                int slideFreeDirection = -1;
                int movementX = ems.Position.X - U.Position.X;
                int movementY = ems.Position.Y - U.Position.Y;
                int desiredQuadrant = DirIndex.Index(U.CurrentVelocityDirection) / 64;
                if (ems.Position.X != U.Sprite.Position.X
                    && (ems.Position.Y == U.Sprite.Position.Y
                        || M.CheckTerrainCollision(movementX, 0))) {
                    if (movementX >= 0) {
                        if (desiredQuadrant == 0) slideFreeDirection = 0;
                        if (desiredQuadrant == 1) slideFreeDirection = -128;
                    } else {
                        if (desiredQuadrant == 3) slideFreeDirection = 0;
                        if (desiredQuadrant == 2) slideFreeDirection = -128;
                    }
                } else {
                    if (movementY < 0) {
                        if (desiredQuadrant == 0) slideFreeDirection = 64;
                        if (desiredQuadrant == 3) slideFreeDirection = -64;
                    } else {
                        if (desiredQuadrant == 1) slideFreeDirection = 64;
                        if (desiredQuadrant == 2) slideFreeDirection = -64;
                    }
                }
                Pathing.Current.SlideFreeDirection = slideFreeDirection;
                U.MovementState = MovementStates.UM_TerrainSlide;
            } else {
                Kin.UpdateUnitHeading(U, U.CurrentVelocityDirection);
            }
        } else {
            Sim.FinishUnitMovement(U, ems);
            U.MovementFlags = U.MovementFlags | 1;
            U.MovementState = MovementStates.UM_FollowPath;
        }
        return false;
    }

    // openbw: bool movement_UM_TerrainSlide(unit_t* u, execute_movement_struct& ems)
    public bool UmTerrainSlide(Ems ems) {
        if (U.PathingCollisionCounter < 255) U.PathingCollisionCounter++;
        if (M.UnitUpdatePathMovementState(true)) return true;
        U.MovementFlags = U.MovementFlags & ~1;
        Dir nextVelocityDirection = U.NextVelocityDirection;
        MoveToward(Pathing.Current.SlideFreeDirection, ems);
        U.MovementFlags = U.MovementFlags | 1;
        U.NextVelocityDirection = nextVelocityDirection;
        Kin.SetDesiredVelocityDirection(U, Dir.FromRaw(Pathing.Current.SlideFreeDirection));
        // openbw: the unit collision is checked before the terrain one.
        if (Collision.CheckUnitMovementUnitCollision(Sim, U, ems.Position.X, ems.Position.Y) != null
            || M.CheckTerrainCollision(ems.Position.X - U.Position.X, ems.Position.Y - U.Position.Y)) {
            U.MovementState = MovementStates.UM_ForceMoveFree;
        } else {
            Sim.FinishUnitMovement(U, ems);
            Fp nextSpeed = U.NextSpeed;
            Kin.SetNextSpeed(U, Pathing.Current.LastCollisionSpeed);
            MoveToward(Kin.XyDirection(new Xy(U.NextMovementWaypoint.X - U.Sprite.Position.X,
                                             U.NextMovementWaypoint.Y - U.Sprite.Position.Y)).RawValue(), ems);
            Kin.SetNextSpeed(U, nextSpeed);
            if (!M.CheckTerrainCollision(ems.Position.X - U.Position.X, ems.Position.Y - U.Position.Y)) {
                U.MovementFlags = U.MovementFlags | 1;
                U.MovementState = MovementStates.UM_FollowPath;
            }
        }
        return false;
    }

    // openbw: the move lambda of movement_UM_TerrainSlide
    private void MoveToward(int direction, Ems ems) {
        ems.PreMovementFlags = U.MovementFlags;
        Kin.SetCurrentVelocityDirection(U, Dir.FromRaw(direction));
        Kin.UpdateCurrentSpeedTowardsWaypoint(U);
        Sim.SetMovementFlags(U, ems);
        Sim.SetMovementValues(U, ems);
        ems.PostMovementFlags = U.MovementFlags;
        U.MovementFlags = ems.PreMovementFlags;
    }

    // openbw: bool movement_UM_ForceMoveFree(unit_t* u, execute_movement_struct& ems)
    public bool UmForceMoveFree(Ems ems) {
        if (U.PathingCollisionCounter < 255) U.PathingCollisionCounter++;
        if (M.IsAtMoveTarget() || M.MovementFlag(4)) {
            U.MovementState = MovementStates.UM_AtMoveTarget;
            return false;
        }
        Kin.SetNextSpeed(U, Fp.Zero());
        Pathing.FreePath();
        U.MovementState = MovementStates.UM_TurnAndStart;
        return true;
    }

    // openbw: bool movement_UM_MoveToLegal(unit_t* u, execute_movement_struct& ems)
    public bool UmMoveToLegal(Ems ems) {
        if (Pathing.Current == null) {
            U.MovementState = MovementStates.UM_CheckIllegal;
            return true;
        }
        if ((U.PathingFlags & 4) != 0) {
            U.PathingFlags = U.PathingFlags & ~4;
            U.SetStatus(StatusFlag.Collision);
            Pathing.FreePath();
            U.MovementState = MovementStates.UM_AtRest;
            return true;
        }
        if ((Pathing.Current.StateFlags & 1) != 0
            || Pathing.Current.NextX != U.NextMovementWaypoint.X
            || Pathing.Current.NextY != U.NextMovementWaypoint.Y) {
            U.NextMovementWaypoint = new Xy(Pathing.Current.NextX, Pathing.Current.NextY);
        }
        if (MoveToLegal(ems)) {
            Pathing.FreePath();
            // openbw: the units that stand in the way are marked before
            // the collision status flag is set.
            Sim.CheckUnitCollision(U);
            U.SetStatus(StatusFlag.Collision);
            U.MovementState = MovementStates.UM_CheckIllegal;
        }
        return false;
    }

    // openbw: the move lambda of movement_UM_MoveToLegal
    private bool MoveToLegal(Ems ems) {
        if (!Pathing.IsMovingAlongPath()) return true;
        Sim.UpdateUnitMovementValues(U, ems);
        if (M.IsInMapBounds(U.UnitType, ems.Position.X, ems.Position.Y)) {
            Sim.FinishUnitMovement(U, ems);
            return false;
        }
        Dir toWaypoint = Kin.XyDirection(new Xy(U.NextMovementWaypoint.X - U.Sprite.Position.X,
                                                U.NextMovementWaypoint.Y - U.Sprite.Position.Y));
        if (U.NextVelocityDirection == toWaypoint) return true;
        Sim.UpdateUnitMovementValues(U, ems);
        Kin.UpdateUnitHeading(U, U.CurrentVelocityDirection);
        return false;
    }

    // openbw: bool movement_UM_TurnAndStart(unit_t* u, execute_movement_struct& ems)
    public bool UmTurnAndStart(Ems ems) {
        // openbw: const unit_t* collision_unit = st.consider_collision_with_unit_bug;
        bool hasCollisionUnit = Sim.HasConsiderCollisionWithUnit;
        int collisionUnitId = Sim.ConsiderCollisionWithUnitId;
        if (Pathing.Current != null) {
            hasCollisionUnit = Pathing.Current.HasLastCollisionUnit;
            collisionUnitId = Pathing.Current.LastCollisionUnit;
            Pathing.FreePath();
        }
        Sim.HasConsiderCollisionWithUnit = hasCollisionUnit;
        if (M.IsAtMoveTarget() || (U.MovementFlags & 4) != 0) {
            U.MovementState = MovementStates.UM_AtMoveTarget;
            return true;
        }
        Sim.HasConsiderCollisionWithUnit = false;
        if (Pathing.UnitPathTo(U.MoveTargetPos.X, U.MoveTargetPos.Y,
                hasCollisionUnit, collisionUnitId)) {
            U.MovementState = MovementStates.UM_FaceTarget;
            return false;
        }
        U.MovementState = MovementStates.UM_FailedPath;
        return true;
    }

    // openbw: bool movement_UM_FaceTarget(unit_t* u, execute_movement_struct& ems)
    public bool UmFaceTarget(Ems ems) {
        if (M.UnitUpdatePathMovementState(true)) return true;
        if (M.IsAtMoveTarget() || (U.MovementFlags & 4) != 0) {
            U.MovementState = MovementStates.UM_AtMoveTarget;
            return true;
        }
        Dir dir = Kin.XyDirection(new Xy(U.NextMovementWaypoint.X - U.Sprite.Position.X,
                                        U.NextMovementWaypoint.Y - U.Sprite.Position.Y));
        if (U.NextVelocityDirection == dir) {
            if (Pathing.Current != null && (Pathing.Current.StateFlags & 1) != 0) {
                U.MovementState = MovementStates.UM_NewMoveTarget;
            } else {
                U.MovementState = MovementStates.UM_FollowPath;
            }
            return true;
        }
        Sim.UpdateUnitMovementValues(U, ems);
        Kin.UpdateUnitHeading(U, U.CurrentVelocityDirection);
        return false;
    }

    // openbw: bool movement_UM_UIOrderDelay(unit_t* u, execute_movement_struct& ems)
    public bool UmUIOrderDelay(Ems ems) {
        if (M.UnitUpdatePathMovementState(true)) return true;
        if (Pathing.Current != null && Pathing.Current.Delay == 0) {
            U.MovementState = MovementStates.UM_FollowPath;
            return true;
        }
        if (Pathing.Current != null) Pathing.Current.Delay--;
        return false;
    }
}
