    //             increment_repulse_field(u);
    //         }
    //         if (being_repulsed) {
    //             if (std::max(std::abs(u->move_target.pos.x - u->position.x), std::abs(u->move_target.pos.y - u->position.y)) < 24) {
    //                 u->move_target.pos = u->position;
    //                 u->next_movement_waypoint = u->position;
    //             }
    //         }
    //     }
    //     return false;
    // }
    public bool MovementUmFlyer(Unit u, Ems ems) {
        if (u.Sprite.Position != u.MoveTargetPos) {
            Xy moveTarget = RestrictUnitPosToBounds(u.MoveTargetPos, u.UnitType, new Xy(0, 0), MapBoundsTo());
            if (moveTarget != u.MoveTargetPos) {
                Kin.SetFlingyMoveTarget(u, moveTarget);
                u.SetStatus(StatusFlag.Immovable);
            }
        }
        UpdateUnitMovementValues(u, ems);
        bool beingRepulsed = ApplyRepulseField(u, ems);
        ems.Position = RestrictUnitPosToBounds(ems.Position, u.UnitType, new Xy(0, 0), MapBoundsTo());
        FinishUnitMovement(u, ems);
        if (u.UCanMove() && !u.UtBuilding()) {
            int index = RepulseIndex(u.Position);
            if (index != u.RepulseIndex) {
                DecrementRepulseField(u);
                IncrementRepulseField(u);
            }
            if (beingRepulsed) {
                int dx = u.MoveTargetPos.X - u.Position.X;
                int dy = u.MoveTargetPos.Y - u.Position.Y;
                int adx = dx < 0 ? -dx : dx;
                int ady = dy < 0 ? -dy : dy;
                int m = adx > ady ? adx : ady;
                if (m < 24) {
                    u.MoveTargetPos = u.Position;
                    u.NextMovementWaypoint = u.Position;
                }
            }
        }
        return false;
    }
}
