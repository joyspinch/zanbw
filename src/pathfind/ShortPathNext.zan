using System;

// The next-short-path step: it picks the target for one hop of the long path
// and runs the short path search towards it.
//
// Port of pathfinder_find_next_short_path() (openbw/bwgame.h 10614-10708),
// pathfinder_adjust_target_pos() (10562-10594) and
// pathfinder_adjust_destination() (10596-10612).

public class ShortPathNext {
    public Regions R;
    public Pathfinder Pf;

    // The unit the path is computed for, and the simulation it lives in.
    // They are needed for the target-unit search: a unit standing on the
    // destination changes how the destination is approached.
    public Sim Sim;
    public Unit U;

    // The unit's half-extent, taken from the unit type dimensions.
    public int DimFromX;
    public int DimFromY;
    public int DimToX;
    public int DimToY;

    public bool Trace;

    public ShortPathNext(Regions r, Pathfinder pf) {
        R = r;
        Pf = pf;
    }

    // openbw: pathfinder_find_next_short_path(pf)
    public bool FindNextShortPath() {
        Pf.CurrentLongPathIndex++;
        if (Pf.CurrentLongPathIndex >= Pf.LongPath.Count) return false;
        int sourceRegion = Pf.LongPath[Pf.CurrentLongPathIndex];
        while (sourceRegion != Pf.SourceRegion) {
            Pf.CurrentLongPathIndex++;
            if (Pf.CurrentLongPathIndex >= Pf.LongPath.Count) return false;
            sourceRegion = Pf.LongPath[Pf.CurrentLongPathIndex];
        }

        int targetX = Pf.Destination;
        int targetY = Pf.DestinationY;
        bool isNearDestination = true;
        bool hasTargetUnit = false;
        Unit spTargetUnit = null;
        int spTargetUnitBbFromX = 0;
        int spTargetUnitBbFromY = 0;
        int spTargetUnitBbToX = 0;
        int spTargetUnitBbToY = 0;
        if (Pf.LongPath.Count - Pf.CurrentLongPathIndex > 3) {
            int midRegion = Pf.LongPath[Pf.CurrentLongPathIndex + 2];
            // openbw: to_xy(region->center) -- the center is an fp8, and the
            // conversion drops the fractional part.
            targetX = R.RegionsList[midRegion].CenterXRaw >> 8;
            targetY = R.RegionsList[midRegion].CenterYRaw >> 8;
            isNearDestination = false;
        }

        int targetRegion = -1;
        if (Pf.CurrentLongPathIndex != Pf.LongPath.Count - 1) {
            targetRegion = Pf.LongPath[Pf.CurrentLongPathIndex + 1];
        } else {
            if (sourceRegion != Pf.DestinationRegion) {
                int[] adjusted = AdjustDestination(sourceRegion, Pf.Destination, Pf.DestinationY);
                Pf.Destination = adjusted[0];
                Pf.DestinationY = adjusted[1];
                Pf.IsStuck = true;
                isNearDestination = true;
                targetRegion = -1;
            }
        }

        if (isNearDestination) {
            // openbw: pf.target_unit = pf.u->move_target.unit; -- the unit
            // the order points at, if any.
            Unit targetUnit = U.HasMoveTargetUnit ? Sim.GetUnit(U.MoveTargetUnitId) : null;
            if (targetUnit == null) {
                // openbw: the units standing on the destination are looked
                // for; the first one that blocks the path becomes the
                // target unit.
                Box unitBb = U.BoundingBoxAt(Pf.Destination, Pf.DestinationY);
                int addX = Sim.MaxUnitWidth / 2 + 1;
                int addY = Sim.MaxUnitHeight / 2 + 1;
                List<Unit> found = Sim.Finder.Find(Sim,
                    Pf.Destination - addX, Pf.Destination + addX,
                    Pf.DestinationY - addY, Pf.DestinationY + addY, false);
                for (int i = 0; i < found.Count; ++i) {
                    Unit other = found[i];
                    bool inter = Box.Intersects(unitBb, other.SpriteBox(true));
                    bool can = Pf.UnitCanCollideWith(Sim, U, other);
                    if (inter && can) {
                        targetUnit = other;
                        break;
                    }
                }
            }
            if (targetUnit != null) {
                // openbw: the target unit's box is grown by the moving
                // unit's dimensions, and the goal is a spot on the border
                // of that box.
                int bbFromX = targetUnit.Position.X - targetUnit.UnitType.DimensionsFrom.X
                    - U.UnitType.DimensionsTo.X - 1;
                int bbFromY = targetUnit.Position.Y - targetUnit.UnitType.DimensionsFrom.Y
                    - U.UnitType.DimensionsTo.Y - 1;
                int bbToX = targetUnit.Position.X + targetUnit.UnitType.DimensionsTo.X
                    + U.UnitType.DimensionsFrom.X + 1;
                int bbToY = targetUnit.Position.Y + targetUnit.UnitType.DimensionsTo.Y
                    + U.UnitType.DimensionsFrom.Y + 1;
                bool isGoal = false;
                if (Pf.Source == bbFromX || Pf.Source == bbToX) {
                    if (Pf.SourceY >= bbFromY && Pf.SourceY <= bbToY) isGoal = true;
                }
                if (Pf.SourceY == bbFromY || Pf.SourceY == bbToY) {
                    if (Pf.Source >= bbFromX && Pf.Source <= bbToX) isGoal = true;
                }
                if (isGoal) {
                    Pf.ShortPath = new List<int[]>();
                    Pf.ShortPath.Add(new int[] { Pf.Source, Pf.SourceY });
                    Pf.Destination = Pf.Source;
                    Pf.DestinationY = Pf.SourceY;
                    Pf.ShortPathIndex = 0;
                    Pf.DestinationReached = true;
                    Pf.IsStuck = false;
                    return true;
                }
                spTargetUnit = targetUnit;
                spTargetUnitBbFromX = bbFromX;
                spTargetUnitBbFromY = bbFromY;
                spTargetUnitBbToX = bbToX;
                spTargetUnitBbToY = bbToY;
                hasTargetUnit = true;
            } else {
                int[] adjusted = AdjustTargetPos(targetX, targetY);
                if (adjusted[0] != 0 && (adjusted[1] != targetX || adjusted[2] != targetY)) {
                    targetX = adjusted[1];
                    targetY = adjusted[2];
                    Pf.Destination = targetX;
                    Pf.DestinationY = targetY;
                }
            }
        }

        ShortPath sp = new ShortPath(R, Pf);
        sp.Sim = Sim;
        sp.U = U;
        sp.SourceRegion = Pf.SourceRegion;
        sp.DestinationRegion = Pf.GetRegionAt(Pf.Destination, Pf.DestinationY);
        sp.TargetX = targetX;
        sp.TargetY = targetY;

        // openbw: the inner/outer offsets come from the unit's dimensions
        // (bwgame.h 9467-9474).
        sp.Inner[0] = DimFromY;
        sp.Outer[0] = DimFromY + 1;
        sp.Inner[1] = -DimToX;
        sp.Outer[1] = -DimToX - 1;
        sp.Inner[2] = -DimToY;
        sp.Outer[2] = -DimToY - 1;
        sp.Inner[3] = DimFromX;
        sp.Outer[3] = DimFromX + 1;

        sp.HasTargetUnit = hasTargetUnit;
        sp.TargetUnitId = hasTargetUnit ? Sim.GetUnitId(spTargetUnit) : 0;
        sp.TargetUnitBbFromX = hasTargetUnit ? spTargetUnitBbFromX : -32000;
        sp.TargetUnitBbFromY = hasTargetUnit ? spTargetUnitBbFromY : -32000;
        sp.TargetUnitBbToX = hasTargetUnit ? spTargetUnitBbToX : -32000;
        sp.TargetUnitBbToY = hasTargetUnit ? spTargetUnitBbToY : -32000;

        ShortPathRun run = new ShortPathRun(sp);
        run.TraceOn = Trace;
        List<int[]> points = run.Run(Pf.Source, Pf.SourceY, targetX, targetY,
                                     targetRegion, Pf.SourceRegion, sp.DestinationRegion,
                                     Pf.Destination, Pf.DestinationY);

        Pf.ShortAllNodesSize = run.AllNodesSize;
        Pf.ShortHighestOpenSize = run.HighestOpenSize;
        Pf.DestinationReached = sp.DestinationReached;
        Pf.IsStuck = Pf.IsStuck || sp.IsStuck;

        // openbw: pathfinder_find_short_path clears pf.short_path before it
        // rebuilds it, so a failed search leaves the list empty.
        Pf.ShortPath = points;
        Pf.ShortPathIndex = 0;
        if (points.Count != 0) {
            int[] last = points[points.Count - 1];
            if (Pf.DestinationReached) {
                if (isNearDestination || last[0] != targetX || last[1] != targetY) {
                    Pf.Destination = last[0];
                    Pf.DestinationY = last[1];
                } else {
                    Pf.DestinationReached = false;
                }
            } else {
                if (targetRegion < 0) {
                    Pf.Destination = last[0];
                    Pf.DestinationY = last[1];
                    Pf.DestinationReached = true;
                    Pf.IsStuck = true;
                }
            }
            return true;
        }
        return false;
    }

    // openbw: pathfinder_adjust_target_pos(unit_inner_bb, target)
    //
    // Returns {found, x, y}: whether the target could be placed on walkable
    // ground, and the adjusted target.
    public int[] AdjustTargetPos(int targetX, int targetY) {
        // openbw: unit_type_inner_bounding_box() returns
        //     { -unit_type->dimensions.from, unit_type->dimensions.to }
        // and translate_rect() shifts it by the target, so the box around
        // the target is { target - from, target + to } -- note that the
        // 'from' side is negated.
        int bx = targetX - DimFromX;
        int by = targetY - DimFromY;
        int tx = targetX + DimToX;
        int ty = targetY + DimToY;
        for (int width = 1; width < 10; width += 2) {
            for (int dir = 0; dir != 4; ++dir) {
                for (int n = 0; n != width; ++n) {
                    if (IsInInnerMapBounds(bx, by, tx, ty)) {
                        bool entirelyWalkable = true;
                        int fromX = bx / 32;
                        int fromY = by / 32;
                        int toX = tx / 32;
                        int toY = ty / 32;
                        for (int y = fromY; entirelyWalkable && y <= toY; ++y) {
                            for (int x = fromX; x <= toX; ++x) {
                                int index = R.TileRegionIndex[256 * y + x];
                                if (index < 0x2000) {
                                    if (!R.RegionsList[index].Walkable()) {
                                        entirelyWalkable = false;
                                        break;
                                    }
                                }
                            }
                        }
                        if (entirelyWalkable) {
                            return new int[] { 1, targetX, targetY };
                        }
                    }
                    targetX += CardinalX[dir] * 8;
                    targetY += CardinalY[dir] * 8;
                    bx = targetX - DimFromX;
                    by = targetY - DimFromY;
                    tx = targetX + DimToX;
                    ty = targetY + DimToY;
                }
                targetX -= CardinalX[dir] * 8;
                targetY -= CardinalY[dir] * 8;
                bx = targetX - DimFromX;
                by = targetY - DimFromY;
                tx = targetX + DimToX;
                ty = targetY + DimToY;
            }
            targetX -= 8;
            targetY -= 8;
            bx = targetX - DimFromX;
            by = targetY - DimFromY;
            tx = targetX + DimToX;
            ty = targetY + DimToY;
        }
        return new int[] { 0, targetX, targetY };
    }

    public bool IsInInnerMapBounds(int fromX, int fromY, int toX, int toY) {
        if (fromX < 32 || fromY < 32) return false;
        if (toX >= R.MapWidth - 32 || toY >= R.MapHeight - 32) return false;
        return true;
    }

    // openbw: pathfinder_adjust_destination(source_region, destination)
    public int[] AdjustDestination(int sourceRegion, int destination, int destinationY) {
        Region src = R.RegionsList[sourceRegion];
        int[] nearest = NearestPosInRect(destination, destinationY,
                                          src.AreaFromX, src.AreaFromY,
                                          src.AreaToX, src.AreaToY);
        int targetX = nearest[0] / 32;
        int targetY = nearest[1] / 32;
        for (int width = 1; width < 16; width += 2) {
            for (int dir = 0; dir != 4; ++dir) {
                for (int n = 0; n != width; ++n) {
                    // openbw casts to size_t, so a negative target compares as
                    // a huge number and the branch is skipped.
                    if (targetX >= 0 && targetY >= 0
                        && targetX < R.MapTileWidth && targetY < R.MapTileHeight) {
                        int r = Pf.GetRegionAtPreferWalkable(targetX * 32, targetY * 32);
                        if (r == sourceRegion) {
                            return new int[] { targetX * 32 + 16, targetY * 32 + 16 };
                        }
                    }
                    targetX += CardinalX[dir];
                    targetY += CardinalY[dir];
                }
                targetX -= CardinalX[dir];
                targetY -= CardinalY[dir];
            }
            targetX -= 1;
            targetY -= 1;
        }
        return new int[] { R.RegionsList[sourceRegion].CenterXRaw >> 8,
                            R.RegionsList[sourceRegion].CenterYRaw >> 8 };
    }

    // openbw: static const std::array<xy, 4> cardinal_direction_xy =
    // {xy{1, 0}, xy{0, 1}, xy{-1, 0}, xy{0, -1}};
    public static int[] CardinalX = new int[] { 1, 0, -1, 0 };
    public static int[] CardinalY = new int[] { 0, 1, 0, -1 };

    // openbw: nearest_pos_in_rect(pos, rect) -- the position in the rect that
    // is closest to pos, clamped component-wise.
    public int[] NearestPosInRect(int posX, int posY, int fromX, int fromY, int toX, int toY) {
        if (fromX > posX) posX = fromX;
        else if (toX < posX) posX = toX;
        if (fromY > posY) posY = fromY;
        else if (toY < posY) posY = toY;
        return new int[] { posX, posY };
    }
}
