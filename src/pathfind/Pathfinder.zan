using System;

// The pathfinder's long-path search: openbw/bwgame.h 9191-9371 plus the
// public entry point at 10710.
//
// The long path is the coarse, region-level route. The short path search
// later refines each hop; that part is a separate slice.

public class Pathfinder {
    public Regions R;
    public AStar Search;

    // the resulting path, as region indices
    public List<int> LongPath;

    public int FullLongPathSize;
    public int LongAllNodesSize;
    public int LongHighestOpenSize;

    public int SourceRegion;
    public int DestinationRegion;

    // the unit's start and end points, in map pixels
    public int Source;
    public int SourceY;
    public int Destination;
    public int DestinationY;

    public bool DestinationReached;
    public bool IsStuck;

    // openbw: pf.consider_collision_with_unit -- the unit the path must
    // go around even when it is on the move.
    public bool HasConsiderCollisionWithUnit;
    public int ConsiderCollisionWithUnitId;

    // openbw: pf.consider_collision_with_moving_units -- when this is set,
    // a unit that is on the move counts as an obstacle too.
    public bool ConsiderCollisionWithMovingUnits;

    // openbw: bool pathfinder_unit_can_collide_with(const unit_t* u, const unit_t* target, const unit_t* consider_collision_with_unit, bool consider_collision_with_moving_units) const {
    //     if (target != consider_collision_with_unit && !consider_collision_with_moving_units) {
    //         if (!unit_is_at_move_target(target)) return false;
    //     }
    //     if (unit_is(target, UnitTypes::Special_Upper_Level_Door)) return false;
    //     if (unit_is(target, UnitTypes::Special_Right_Upper_Level_Door)) return false;
    //     if (unit_is(target, UnitTypes::Special_Pit_Door)) return false;
    //     if (unit_is(target, UnitTypes::Special_Right_Pit_Door)) return false;
    //     return unit_can_collide_with(u, target);
    // }
    //
    // The pathfinder only treats a unit as an obstacle when the unit stands
    // still on its own move target: a unit that is on its way somewhere else
    // is not in the way. The consider unit is the one the path was blocked
    // by last time, so the new path goes around it even when it moves.
    public bool UnitCanCollideWith(Sim sim, Unit u, Unit target) {
        bool isConsiderUnit = HasConsiderCollisionWithUnit
            && sim.GetUnitId(target) == ConsiderCollisionWithUnitId;
        if (!isConsiderUnit && !ConsiderCollisionWithMovingUnits) {
            if (!target.IsAtMoveTarget()) return false;
        }
        return UnitCanCollideWithIgnoringMoveTarget(sim, u, target);
    }

    // openbw: bool pathfinder_unit_can_collide_with(const unit_t* u, const unit_t* target, const unit_t* consider_collision_with_unit, bool consider_collision_with_moving_units)
    //
    // The explicit form. A target that is not the consider unit and moving
    // units are not obstacles only when consider_collision_with_moving_units
    // is false.
    public static bool UnitCanCollideWithIgnoringMoveTarget(Sim sim, Unit u, Unit target) {
        // The doors are never in the way.
        if (target.UnitType.Id == (int)UnitTypes.SpecialUpperLevelDoor) return false;
        if (target.UnitType.Id == (int)UnitTypes.SpecialRightUpperLevelDoor) return false;
        if (target.UnitType.Id == (int)UnitTypes.SpecialPitDoor) return false;
        if (target.UnitType.Id == (int)UnitTypes.SpecialRightPitDoor) return false;
        return sim.UnitCanCollideWith(u, target);
    }

    // The unit is not the consider unit, so the move target does not
    // matter: a moving unit is in the way too.
    public static bool UnitCanCollideWithMoving(Sim sim, Unit u, Unit target) {
        return UnitCanCollideWithIgnoringMoveTarget(sim, u, target);
    }

    // the index into LongPath that the next short path hop starts from
    public int CurrentLongPathIndex;
    public int ShortAllNodesSize;
    public int ShortHighestOpenSize;
    public List<int[]> ShortPath;
    public int ShortPathIndex;

    public Pathfinder(Regions r) {
        R = r;
        Search = new AStar(r);
        LongPath = new List<int>();
        ShortPath = new List<int[]>();
    }

    // openbw: get_region_at(xy pos)
    public int GetRegionAt(int posX, int posY) {
        int index = R.TileRegionIndex[(posY / 32) * 256 + (posX / 32)];
        if (index >= 0x2000) {
            int maskIndex = ((posY / 8) & 3) * 4 + ((posX / 8) & 3);
            SplitRegion split = R.SplitRegions[index - 0x2000];
            if ((split.Mask & (1 << maskIndex)) != 0) return split.B;
            else return split.A;
        }
        return index;
    }

    // openbw: get_region_at_prefer_walkable(pos) -- ignores the split region
    // mask and always returns the 'a' half.
    public int GetRegionAtPreferWalkable(int posX, int posY) {
        int index = R.TileRegionIndex[(posY / 32) * 256 + (posX / 32)];
        if (index >= 0x2000) {
            return R.SplitRegions[index - 0x2000].A;
        }
        return index;
    }

    // openbw: pathfinder_find_long_path(pf, from, to)
    public bool FindLongPath(int srcX, int srcY, int dstX, int dstY) {
        SourceRegion = GetRegionAt(srcX, srcY);
        DestinationRegion = GetRegionAt(dstX, dstY);
        LongAllNodesSize = 0;
        LongHighestOpenSize = 0;
        Search.LongHighestOpenSize = 0;

        if (SourceRegion == DestinationRegion) {
            LongPath = new List<int>();
            LongPath.Add(SourceRegion);
            FullLongPathSize = 1;
            return true;
        }
        return FindLongPathInner(srcX, srcY, dstX, dstY);
    }

    // openbw: pathfinder_find_long_path(pathfinder& pf)
    public bool FindLongPathInner(int srcX, int srcY, int dstX, int dstY) {
        bool pathIsReversed;
        if (R.RegionsList[SourceRegion].GroupIndex == R.RegionsList[DestinationRegion].GroupIndex) {
            Search.Find(SourceRegion, DestinationRegion, srcX, srcY, dstX, dstY,
                        SourceRegion, DestinationRegion);
            pathIsReversed = false;
        } else {
            Search.Find(DestinationRegion, SourceRegion, srcX, srcY, dstX, dstY,
                        SourceRegion, DestinationRegion);
            pathIsReversed = true;
            int goalRegion = Search.Nodes[Search.GoalNode].RegionIndex;
            if (goalRegion != SourceRegion) {
                for (int i = 0; i != Search.Nodes.Count; ++i) {
                    R.RegionsList[Search.Nodes[i].RegionIndex].PathfinderNode = -1;
                }
                Search.Find(SourceRegion, goalRegion,
                            srcX, srcY, dstX, dstY, SourceRegion, DestinationRegion);
                pathIsReversed = false;
            }
        }

        LongAllNodesSize = Search.Nodes.Count;

        LongPath = new List<int>();
        FullLongPathSize = 0;
        // openbw: pf.current_long_path_index = (size_t)0 - 1;
        CurrentLongPathIndex = -1;
        int goalNode = Search.GoalNode;
        int fullPathSize = 0;

        if (pathIsReversed) {
            int goalGroupIndex = R.RegionsList[Search.Nodes[goalNode].RegionIndex].GroupIndex;
            int n = goalNode;
            while (n != -1) {
                if (R.RegionsList[Search.Nodes[n].RegionIndex].GroupIndex != goalGroupIndex) break;
                if (LongPath.Count != 50) {
                    LongPath.Add(R.RegionsList[Search.Nodes[n].RegionIndex].Index);
                }
                ++fullPathSize;
                n = Search.Nodes[n].Prev;
            }
        } else {
            int n = goalNode;
            while (n != -1) {
                ++fullPathSize;
                n = Search.Nodes[n].Prev;
            }
            for (int i = fullPathSize; i > 50; --i) {
                goalNode = Search.Nodes[goalNode].Prev;
            }
            // the C++ pushes to the front, so the path ends up reversed
            List<int> reversed = new List<int>();
            n = goalNode;
            while (n != -1) {
                reversed.Add(R.RegionsList[Search.Nodes[n].RegionIndex].Index);
                n = Search.Nodes[n].Prev;
            }
            for (int i = reversed.Count - 1; i >= 0; --i) {
                LongPath.Add(reversed[i]);
            }
        }
        FullLongPathSize = fullPathSize;

        for (int i = 0; i != Search.Nodes.Count; ++i) {
            R.RegionsList[Search.Nodes[i].RegionIndex].PathfinderNode = -1;
        }
        return LongPath.Count != 0;
    }
}
