using System;

// The sight range table, shared by the whole map.
public class Vision {
    public TileMap Map;
    public List<SightValues> SightValues;

    public Vision(TileMap map, List<SightValues> sightValues) {
        Map = map;
        SightValues = sightValues;
    }

    // openbw: int get_ground_height_at(xy pos) const
    //
    // 2 = the tile is high ground, 1 = middle, 0 = low.
    public int GetGroundHeightAt(int posX, int posY) {
        int index = Map.TileIndex(posX, posY);
        int raw = Map.Tiles[index].GfxTile;
        int groupIndex = (raw >> 4) & 0x7ff;
        int subtileIndex = raw & 0xf;
        int megaTileIndex = Map.Cv5[groupIndex * 16 + subtileIndex];
        int ux = posX;
        int uy = posY;
        int flags = Map.Vf4[megaTileIndex * 16 + (uy / 8 % 4) * 4 + (ux / 8 % 4)];
        if ((flags & (int)Vf4Flag.High) != 0) return 2;
        if ((flags & (int)Vf4Flag.Middle) != 0) return 1;
        return 0;
    }

    // openbw: void reveal_sight_at(xy pos, int range, int reveal_to, bool in_air)
    //
    // Reveals the tiles around pos to the players in reveal_to. A tile's
    // visibility depends on the tiles "before" it in the sight table: a
    // tile that is blocked by high ground is not revealed.
    public void RevealSightAt(int posX, int posY, int range, int revealTo, bool inAir) {
        int visibilityMask = ~revealTo;
        int heightMask = 0;
        if (!inAir) {
            int height = GetGroundHeightAt(posX, posY);
            if (height == 2) heightMask = (int)TileFlag.VeryHigh;
            else if (height == 1) heightMask = (int)TileFlag.VeryHigh | (int)TileFlag.High;
            else heightMask = (int)TileFlag.VeryHigh | (int)TileFlag.High | (int)TileFlag.Middle;
        }

        int maxWidth = 11 * 2 + 3;
        int[] visionPropagation = new int[maxWidth * maxWidth];

        // The mask a tile's flags / explored / visible have to match for
        // the tile to let the sight through.
        int requiredTileMask = (heightMask << 16)
            | ((~visibilityMask & 0xff) << 8)
            | (~visibilityMask & 0xff);

        SightValues sightVals = SightValues[range];
        int tileX = posX / 32;
        int tileY = posY / 32;

        if (!inAir) {
            int index = 0;
            int end = sightVals.MinMaskSize;
            for (; index != end; ++index) {
                SightValuesMaskNode cur = sightVals.MaskDat[index];
                visionPropagation[index] = 0xff;
                int tx = tileX + cur.X;
                int ty = tileY + cur.Y;
                if (!InMap(tx, ty)) continue;
                Tile tile = Map.Tiles[ty * Map.MapTileWidth + tx].Tile;
                tile.Visible = tile.Visible & visibilityMask;
                tile.Explored = tile.Explored & visibilityMask;
                visionPropagation[index] = (tile.Flags << 16) | (tile.Explored << 8) | tile.Visible;
            }
            end += sightVals.ExtMaskedCount;
            for (; index != end; ++index) {
                SightValuesMaskNode cur = sightVals.MaskDat[index];
                visionPropagation[index] = 0xff;
                int tx = tileX + cur.X;
                int ty = tileY + cur.Y;
                if (!InMap(tx, ty)) continue;
                if ((visionPropagation[cur.Prev] & requiredTileMask) != 0) {
                    if (cur.Prev2 == -1 || (visionPropagation[cur.Prev2] & requiredTileMask) != 0) continue;
                }
                Tile tile = Map.Tiles[ty * Map.MapTileWidth + tx].Tile;
                tile.Visible = tile.Visible & visibilityMask;
                tile.Explored = tile.Explored & visibilityMask;
                visionPropagation[index] = (tile.Flags << 16) | (tile.Explored << 8) | tile.Visible;
            }
        } else {
            // openbw: "This seems bugged; even for air units, if you only
            // traverse ext_masked_count nodes, then you will still miss out
            // on the min_mask_size (9) last ones"
            int end = sightVals.ExtMaskedCount;
            for (int cur = 0; cur != end; ++cur) {
                SightValuesMaskNode node = sightVals.MaskDat[cur];
                int tx = tileX + node.X;
                int ty = tileY + node.Y;
                if (!InMap(tx, ty)) continue;
                Tile tile = Map.Tiles[ty * Map.MapTileWidth + tx].Tile;
                tile.Visible = tile.Visible & visibilityMask;
                tile.Explored = tile.Explored & visibilityMask;
            }
        }
    }

    // openbw: the bounds check is written as `tile_x + cur.x >= map_tile_width`
    // with a size_t on the left, so a negative offset wraps around to a
    // huge value and the node is skipped. The signed form of the same
    // test is "outside the map".
    private bool InMap(int tx, int ty) {
        if (tx < 0 || tx >= Map.MapTileWidth) return false;
        if (ty < 0 || ty >= Map.MapTileHeight) return false;
        return true;
    }
}
