using System;

// The sight range table.
//
// openbw's game_types.h::sight_values_t holds one entry per sight range.
// Each entry describes a diamond-shaped area of tiles that a unit of that
// sight range can see, together with a propagation order that lets the
// visibility of one tile depend on the tiles "before" it.
//
// The table is generated by generate_sight_values(); it is not loaded from
// a file. The generation is a fixed algorithm, so the whole table is
// reproducible from the range count alone -- which is exactly what the
// differential bed checks.
public class SightValuesMaskNode {
    // The index of the node this one's visibility depends on. -1 means
    // "no second dependency"; the C++ spells that (size_t)-1.
    public int Prev;
    public int Prev2;

    // The tile's offset from the centre tile, as a flat index into the
    // tile row (y * map_tile_width + x).
    public int RelativeTileIndex;

    // The tile's offset from the centre tile.
    public int X;
    public int Y;

    public SightValuesMaskNode() {
        // openbw: the maskdat array is a std::vector that is resized, so
        // the nodes start out zeroed. The centre node is never written
        // by the generator, so its prev / prev2 stay zero -- that is
        // what the C++ bed prints for node 0.
        Prev = 0;
        Prev2 = 0;
        RelativeTileIndex = 0;
        X = 0;
        Y = 0;
    }
}

public class SightValues {
    public int MaxWidth;
    public int MaxHeight;
    public int MinWidth;
    public int MinHeight;

    // The number of nodes in the always-revealed centre square.
    public int MinMaskSize;

    // The number of nodes outside the centre square.
    public int ExtMaskedCount;

    public List<SightValuesMaskNode> MaskDat;

    public SightValues() {
        MaxWidth = 0;
        MaxHeight = 0;
        MinWidth = 0;
        MinHeight = 0;
        MinMaskSize = 0;
        ExtMaskedCount = 0;
        MaskDat = new List<SightValuesMaskNode>();
    }
}

// openbw: void generate_sight_values()
//
// The base mask is a diamond inscribed in the max_width x max_height square.
// The nodes are then visited in rings of increasing radius; each node
// records which already-visited node it depends on (prev) and, when the
// dependency is not on a direct neighbour, a second one (prev2).
public class SightValuesGenerator {

    // One cell of the base mask: whether the cell is inside the sight
    // diamond, and the index of the maskdat node that was assigned to it.
    private class BaseMaskCell {
        public bool Masked;
        public int MaskDatNode;

        public BaseMaskCell() {
            Masked = false;
            MaskDatNode = -1;
        }
    }

    public static List<SightValues> Generate(int count, int mapTileWidth) {
        List<SightValues> result = new List<SightValues>();
        for (int i = 0; i < count; ++i) {
            result.Add(new SightValues());
        }

        for (int i = 0; i < count; ++i) {
            SightValues v = result[i];
            v.MaxWidth = 3 + i * 2;
            v.MaxHeight = 3 + i * 2;
            v.MinWidth = 3;
            v.MinHeight = 3;
            v.MinMaskSize = 0;
            v.ExtMaskedCount = 0;

            List<BaseMaskCell> baseMask = new List<BaseMaskCell>();
            for (int k = 0; k < v.MaxWidth * v.MaxHeight; ++k) {
                baseMask.Add(new BaseMaskCell());
            }

            v.MinMaskSize = v.MinWidth * v.MinHeight;
            int offX = v.MaxWidth / 2 - v.MinWidth / 2;
            int offY = v.MaxHeight / 2 - v.MinHeight / 2;
            for (int y = 0; y < v.MinHeight; ++y) {
                for (int x = 0; x < v.MinWidth; ++x) {
                    baseMask[(offY + y) * v.MaxWidth + offX + x].Masked = true;
                }
            }

            GenerateBaseMask(v, baseMask);

            int maskedCount = 0;
            for (int k = 0; k < baseMask.Count; ++k) {
                if (baseMask[k].Masked) ++maskedCount;
            }

            v.ExtMaskedCount = maskedCount - v.MinMaskSize;
            v.MaskDat = new List<SightValuesMaskNode>();
            for (int k = 0; k < maskedCount; ++k) {
                v.MaskDat.Add(new SightValuesMaskNode());
            }

            int centerIndex = v.MaxHeight / 2 * v.MaxWidth + v.MaxWidth / 2;
            baseMask[centerIndex].MaskDatNode = 0;

            int nextEntryIndex = 1;
            int curX = -1;
            int curY = -1;
            int addedCount = 1;

            int[] directionX = new int[] { 1, 0, -1, 0 };
            int[] directionY = new int[] { 0, 1, 0, -1 };
            int[] maxI = new int[] { v.MaxHeight, v.MaxWidth, v.MaxHeight, v.MaxWidth };

            for (int i = 2; addedCount < maskedCount; i += 2) {
                for (int dir = 0; dir < 4; ++dir) {
                    int thisX = 0;
                    int thisY = 0;
                    if (i > maxI[dir]) {
                        thisX = curX + i * directionX[dir];
                        thisY = curY + i * directionY[dir];
                        DoN(v, baseMask, centerIndex, directionX, directionY, dir,
                            ref thisX, ref thisY, 1,
                            ref nextEntryIndex, ref addedCount, mapTileWidth);
                    } else {
                        thisX = curX + directionX[dir];
                        thisY = curY + directionY[dir];
                        int n = maxI[(dir + 1) % 4] - 1;
                        if (i < n) n = i;
                        DoN(v, baseMask, centerIndex, directionX, directionY, dir,
                            ref thisX, ref thisY, n,
                            ref nextEntryIndex, ref addedCount, mapTileWidth);
                    }
                    curX = thisX - directionX[dir];
                    curY = thisY - directionY[dir];
                }
                if (i < v.MaxWidth - 1) --curX;
                if (i < v.MaxHeight - 1) --curY;
            }
        }

        return result;
    }

    // openbw: the generate_base_mask lambda -- it paints the diamond.
    private static void GenerateBaseMask(SightValues v, List<BaseMaskCell> baseMask) {
        int offset = v.MaxHeight / 2 - v.MaxWidth / 2;
        int halfWidth = v.MaxWidth / 2;
        int maxX2 = halfWidth;
        int maxX1 = halfWidth * 2;
        int curX1 = 0;
        int curX2 = halfWidth;
        int i = 0;
        int maxI = halfWidth;
        int curSize1 = 0;
        int curSize2 = halfWidth * halfWidth;
        int minCurSize2 = halfWidth * (halfWidth - 1);
        int minCurSize2Chg = halfWidth * 2;
        while (true) {
            if (curX1 <= maxX1) {
                for (int k = 0; k <= maxX1 - curX1; ++k) {
                    Mask(baseMask, (offset + curX2) * v.MaxWidth + curX1 + k);
                    Mask(baseMask, (offset + maxX2) * v.MaxWidth + curX1 + k);
                }
            }
            if (curX2 <= maxX2) {
                for (int k = 0; k <= maxX2 - curX2; ++k) {
                    Mask(baseMask, (offset + curX1) * v.MaxWidth + curX2 + k);
                    Mask(baseMask, (offset + maxX1) * v.MaxWidth + curX2 + k);
                }
            }
            curSize2 += 1 - curSize1 - 2;
            curSize1 += 2;
            --curX2;
            ++maxX2;
            if (curSize2 <= minCurSize2) {
                --maxI;
                ++curX1;
                --maxX1;
                minCurSize2 -= minCurSize2Chg - 2;
                minCurSize2Chg -= 2;
            }

            ++i;
            if (i > maxI) break;
        }
    }

    private static void Mask(List<BaseMaskCell> baseMask, int index) {
        baseMask[index].Masked = true;
    }

    // openbw: the do_n lambda -- it walks n cells along one direction and
    // records the dependency of every masked cell it passes. thisX and
    // thisY are updated in place, like the C++'s captured references.
    //
    // The cell coordinates are relative to the centre of the base mask,
    // exactly like the C++'s at() helper, which adds the relative index
    // to the centre index.
    private static void DoN(SightValues v, List<BaseMaskCell> baseMask, int centerIndex,
        int[] directionX, int[] directionY, int dir, ref int thisX, ref int thisY, int n,
        ref int nextEntryIndex, ref int addedCount, int mapTileWidth) {
        for (int k = 0; k < n; ++k) {
            if (baseMask[centerIndex + thisY * v.MaxWidth + thisX].Masked) {
                if (thisX != 0 || thisY != 0) {
                    int entryIndex = nextEntryIndex;
                    ++nextEntryIndex;

                    int prevX = thisX;
                    int prevY = thisY;
                    if (prevX > 0) --prevX;
                    else if (prevX < 0) ++prevX;
                    if (prevY > 0) --prevY;
                    else if (prevY < 0) ++prevY;

                    int prev = baseMask[centerIndex + prevY * v.MaxWidth + prevX].MaskDatNode;
                    int prev2 = -1;
                    if (Abs(prevX) != Abs(prevY)
                        && !(thisX == 0 && directionX[dir] != 0)
                        && !(thisY == 0 && directionY[dir] != 0)) {
                        int prev2X = prevX;
                        int prev2Y = prevY;
                        if (Abs(prev2X) <= Abs(prev2Y)) {
                            if (thisX >= 0) ++prev2X;
                            else --prev2X;
                        } else {
                            if (thisY >= 0) ++prev2Y;
                            else --prev2Y;
                        }
                        prev2 = baseMask[centerIndex + prev2Y * v.MaxWidth + prev2X].MaskDatNode;
                    }

                    SightValuesMaskNode entry = v.MaskDat[entryIndex];
                    entry.Prev = prev;
                    entry.Prev2 = prev2;
                    entry.RelativeTileIndex = thisY * mapTileWidth + thisX;
                    entry.X = thisX;
                    entry.Y = thisY;

                    baseMask[centerIndex + thisY * v.MaxWidth + thisX].MaskDatNode = entryIndex;
                    ++addedCount;
                }
            }
            thisX += directionX[dir];
            thisY += directionY[dir];
        }
    }

    private static int Abs(int v) {
        return v < 0 ? -v : v;
    }
}
